[Quadlet]
DefaultDependencies=false

[Unit]
Description=Memos

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}
ContainerName=memos
HostName=memos
PublishPort={{ services['containers']['memos']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['memos']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['memos']['units']['main']['ports']['http']['protocol'] }}

# Volumes
Volume={{ nodes[target_host]['paths']['data'] }}/containers/memos/data:/var/opt/memos:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/memos/ssl:/etc/ssl/memos:ro

# General
Environment="TZ={{ site['timezone'] }}"
Environment="MEMOS_MODE=prod"
Environment="MEMOS_PORT=5230"
Environment="MEMOS_INSTANCE_URL=https://{{ services['containers']['memos']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"

# Database (PostgreSQL)
Environment="MEMOS_DRIVER=postgres"
Secret=MEMOS_DSN,type=env

[Service]
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
