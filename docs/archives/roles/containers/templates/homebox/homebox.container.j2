[Quadlet]
DefaultDependencies=false

[Unit]
Description=Homebox

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=homebox
HostName=homebox

PublishPort={{ services['containers']['homebox']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['homebox']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['homebox']['units']['main']['ports']['http']['protocol'] }}

# Volumes
Volume={{ nodes[target_host]['paths']['data'] }}/containers/homebox/data:/data:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/homebox/ssl:/etc/ssl/homebox:ro

# Environment
Environment="TZ={{ site['timezone'] }}"
Secret=HBOX_AUTH_API_KEY_PEPPER,type=env
# OIDC
Environment="HBOX_OIDC_ENABLED=true"
Environment="HBOX_OIDC_ISSUER_URL=https://{{ services['containers']['authelia']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
Environment="HBOX_OIDC_CLIENT_ID=homebox"
Environment="HBOX_OIDC_SCOPE=openid profile email groups"
Environment="HBOX_OIDC_BUTTON_TEXT=Sign in with Authelia"
Environment="HBOX_OPTIONS_TRUST_PROXY=true"
Environment="HBOX_OIDC_ALLOWED_GROUPS=admins,users"
Environment="HBOX_OPTIONS_ALLOW_LOCAL_LOGIN=false"
Secret=HBOX_OIDC_CLIENT_SECRET,type=env

# Database
Environment="HBOX_DATABASE_DRIVER=postgres"
Environment="HBOX_DATABASE_HOST={{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}"
Environment="HBOX_DATABASE_PORT={{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}"
Environment="HBOX_DATABASE_USERNAME=homebox"
Environment="HBOX_DATABASE_DATABASE=homebox_db"
Environment="HBOX_DATABASE_SSL_MODE=verify-full"
Environment="HBOX_DATABASE_SSL_ROOT_CERT=/etc/ssl/homebox/{{ site['ca']['x509']['root']['certificate_file'] }}"
Secret=HBOX_DATABASE_PASSWORD,type=env

[Service]
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
