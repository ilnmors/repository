[Quadlet]
DefaultDependencies=false

[Unit]
Description=Actual Budget

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}
ContainerName=actual-budget
HostName=actual-budget

PublishPort={{ services['containers']['actual-budget']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['actual-budget']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['actual-budget']['units']['main']['ports']['http']['protocol'] }}

Volume={{ nodes[target_host]['paths']['data'] }}/containers/actual-budget:/data:rw

Environment="TZ={{ site['timezone'] }}"
Environment="ACTUAL_OPENID_DISCOVERY_URL=https://{{ services['containers']['authelia']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}/.well-known/openid-configuration"
Environment="ACTUAL_OPENID_CLIENT_ID=actual-budget"
Environment="ACTUAL_OPENID_SERVER_HOSTNAME=https://{{ services['containers']['actual-budget']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
Environment="ACTUAL_OPENID_AUTH_METHOD=oauth2"
Secret=ACTUAL_OPENID_CLIENT_SECRET,type=env

[Service]
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
