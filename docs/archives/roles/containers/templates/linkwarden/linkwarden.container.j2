[Quadlet]
DefaultDependencies=false

[Unit]
Description=LinkWarden

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}
ContainerName=linkwarden
HostName=linkwarden
PublishPort={{ services['containers']['linkwarden']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['linkwarden']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['linkwarden']['units']['main']['ports']['http']['protocol'] }}

# Volumes
Volume={{ nodes[target_host]['paths']['data'] }}/containers/linkwarden/data:/data/data:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/linkwarden/ssl:/etc/ssl/linkwarden:ro

# General
Environment="TZ={{ site['timezone'] }}"
Environment="NEXTAUTH_URL=https://{{ services['containers']['linkwarden']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}/api/v1/auth"
Environment="ALLOW_PRIVATE_NETWORK_ACCESS=true"
Environment="ALLOW_INSECURE_TLS=false"
Secret=LINKWARDEN_SECRET_KEY,type=env,target=NEXTAUTH_SECRET

# Database (PostgreSQL)
# postgresql://linkwarden:PASSWORD@db.example.com:5432/linkwarden_db?sslmode=require&sslrootcert=/run/secrets/postgres-ca.crt&sslaccept=strict
Secret=LINKWARDEN_DATABASE_URL,type=env,target=DATABASE_URL

# OIDC
Environment="NEXT_PUBLIC_OIDC_ENABLED=true"
Environment="OIDC_CUSTOM_NAME=Authelia"
Environment="OIDC_WELLKNOWN_URL=https://{{ services['containers']['authelia']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}/.well-known/openid-configuration"
Environment="OIDC_CLIENT_ID=linkwarden"
Environment="OIDC_SCOPES=openid groups email profile"
Environment="NEXT_PUBLIC_DISABLE_REGISTRATION=true"
Environment="NEXT_PUBLIC_CREDENTIALS_ENABLED=false"
Environment="DISABLE_NEW_SSO_USERS=false"
Secret=LINKWARDEN_OIDC_CLIENT_SECRET,type=env,target=OIDC_CLIENT_SECRET

# Archiving
Environment="DISABLE_BROWSER=true"
Environment="NEXT_PUBLIC_MAX_FILE_BUFFER=250"
# Meili search
# Environment=MEILI_HOST=""
# Environment=MEILI_MASTER_KEY=""

[Service]
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
