[Quadlet]
DefaultDependencies=false

[Unit]
Description=Papra

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=papra
HostName=papra

PublishPort={{ services['containers']['papra']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['papra']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['papra']['units']['main']['ports']['http']['protocol'] }}

# Volumes
Volume={{ nodes[target_host]['paths']['data'] }}/containers/papra/data:/app/app-data:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/papra/db:/app/app-data/db:rw
Volume={{ nodes[target_host]['paths']['data'] }}/containers/papra/backup:/app/backup:rw

# General
Environment="TZ={{ site['timezone'] }}"
Environment="APP_BASE_URL=https://{{ services['containers']['papra']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"

# Authentication
Environment="AUTH_PROVIDERS_EMAIL_IS_ENABLED=false"
Environment="AUTH_IS_PASSWORD_RESET_ENABLED=false"
Environment="AUTH_SHOW_LEGAL_LINKS=false"
Secret=PAPRA_AUTH_SECRET,type=env,target=AUTH_SECRET

# OIDC
Secret=PAPRA_AUTH_PROVIDERS_CUSTOMS,type=env,target=AUTH_PROVIDERS_CUSTOMS

# Documents
Environment="DOCUMENTS_CONTENT_EXTRACTION_ENABLED=true"
Environment="DOCUMENTS_OCR_LANGUAGES=eng,kor"
Environment="DOCUMENT_STORAGE_MAX_UPLOAD_SIZE=0"

RunInit=true

[Service]
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
