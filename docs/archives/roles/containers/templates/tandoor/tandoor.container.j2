[Quadlet]
DefaultDependencies=false

[Unit]
Description=Tandoor Recipes

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=tandoor
HostName=tandoor

PublishPort={{ services['containers']['tandoor']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['tandoor']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['tandoor']['units']['main']['ports']['http']['protocol'] }}

# Volumes
Volume={{ nodes[target_host]['paths']['data'] }}/containers/tandoor/mediafiles:/opt/recipes/mediafiles:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/tandoor/ssl:/etc/ssl/tandoor:ro

# General
Environment="TZ={{ site['timezone'] }}"
Environment="ALLOWED_HOSTS={{ services['containers']['tandoor']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
Environment="CSRF_TRUSTED_ORIGINS=https://{{ services['containers']['tandoor']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
# auth Caddy -> app Caddy -> Tandoor built-in nginx
Environment="ALLAUTH_TRUSTED_PROXY_COUNT=3"
# Set Django gunicorn worker as 1, and threads as 2
Environment="GUNICORN_WORKERS=1"
Environment="GUNICORN_THREADS=2"

# Secrets
Secret=TANDOOR_SECRET_KEY,type=env,target=SECRET_KEY

# Database (PostgreSQL)
Environment="DB_ENGINE=django.db.backends.postgresql"
Environment="POSTGRES_HOST={{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}"
Environment="POSTGRES_PORT={{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}"
Environment="POSTGRES_USER=tandoor"
Environment="POSTGRES_DB=tandoor_db"
Environment="PGSSLMODE=verify-full"
Environment="PGSSLROOTCERT=/etc/ssl/tandoor/{{ site['ca']['x509']['root']['certificate_file'] }}"
Secret=TANDOOR_POSTGRES_PASSWORD,type=env,target=POSTGRES_PASSWORD

# Login
# HIDE_LOGIN_FORM was dropped in 2.7; the new login page only reads SOCIALACCOUNT_ONLY.
Environment="SOCIALACCOUNT_ONLY=1"
Environment="ENABLE_SIGNUP=0"

# OIDC
Environment="SOCIAL_PROVIDERS=allauth.socialaccount.providers.openid_connect"
Environment="SOCIALACCOUNT_AUTO_SIGNUP=1"
Environment="SOCIALACCOUNT_LOGIN_ON_GET=1"
Environment="SOCIAL_DEFAULT_ACCESS=1"
Environment="SOCIAL_DEFAULT_GROUP=user"
Secret=TANDOOR_SOCIALACCOUNT_PROVIDERS,type=env,target=SOCIALACCOUNT_PROVIDERS

[Service]
MemoryKSM=yes
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
