role_assignment:
  driver: "oidc"
  oidc_role_mapper:
    role_claim: "preferred_username"
    role_mapping:
{% for admin_user in ["il"] %}
      - role_name: "admin"
        claim_value: "{{ admin_user }}"
{% endfor %}
{# List the preferred_username of each non-admin user. #}
{% for general_user in [] %}
      - role_name: "user"
        claim_value: "{{ general_user }}"
{% endfor %}
