[Quadlet]
DefaultDependencies=false

[Unit]
Description=stable-diffusion.cpp Image Generation Server

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=stablediffusion
HostName=stablediffusion
PublishPort={{ services['containers']['stablediffusion']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['stablediffusion']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['stablediffusion']['units']['main']['ports']['http']['protocol'] }}

# iGPU access for container
AddDevice=/dev/dri:/dev/dri
PodmanArgs=--group-add keep-groups

Volume={{ nodes[target_host]['paths']['home'] }}/containers/stablediffusion/models:/models:ro

# General
Environment="TZ={{ site['timezone'] }}"
# Prevent Fence expiration time out f9r CYCL
Environment="SYCL_PI_LEVEL_ZERO_USE_IMMEDIATE_COMMANDLISTS=1"

Entrypoint=/sd-server
Exec=--listen-ip 0.0.0.0 \
     --listen-port 1234 \
     {{ services['containers']['stablediffusion']['units']['main']['dependency']['models'][services['containers']['stablediffusion']['units']['main']['dependency']['models']['active']] }}

[Service]
Restart=always
RestartSec=60s
TimeoutStopSec=300

[Install]
WantedBy=default.target
