{
	"root": "/home/step/certs/{{ site['ca']['x509']['root']['certificate_file'] }}",
	"federatedRoots": null,
	"crt": "/home/step/certs/{{ site['ca']['x509']['intermediate']['certificate_file'] }}",
	"key": "/home/step/secrets/{{ site['ca']['x509']['intermediate']['private_key_file'] }}",
	"address": ":9000",
	"insecureAddress": "",
	"dnsNames": [
		"{{ services['containers']['ca']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}"
	],
	"logger": {
		"format": "text"
	},
	"db": {
		"type": "badgerv2",
		"dataSource": "/home/step/db",
		"badgerFileLoadingMode": ""
	},
	"authority": {
		"policy": {
			"x509": {
				"allow": {
					"dns": [
						"{{ site['domain']['internal'] }}",
						"*.{{ site['domain']['internal'] }}",
						"*.app.{{ site['domain']['internal'] }}"
					]
				},
				"allowWildcardNames": true
			}
		},
		"provisioners": [
			{
				"type": "ACME",
				"name": "acme@{{ site['domain']['internal'] }}",
				"claims": {
					"defaultTLSCertDuration": "2160h0m0s",
					"enableSSHCA": true,
					"disableRenewal": false,
					"allowRenewalAfterExpiry": false,
					"disableSmallstepExtensions": false
				},
				"options": {
					"x509": {},
					"ssh": {}
				}
			}
		],
		"template": {},
		"backdate": "1m0s"
	},
	"tls": {
		"cipherSuites": [
			"TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256",
			"TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256"
		],
		"minVersion": 1.2,
		"maxVersion": 1.3,
		"renegotiation": false
	},
	"commonName": "{{ site['domain']['internal'] }} Online CA"
}
