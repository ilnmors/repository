[Quadlet]
DefaultDependencies=false

[Unit]
Description=Mealie

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}
ContainerName=mealie
HostName=mealie
PublishPort={{ services['containers']['mealie']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['mealie']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['mealie']['units']['main']['ports']['http']['protocol'] }}

# Volumes
Volume={{ nodes[target_host]['paths']['data'] }}/containers/mealie/data:/app/data:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/mealie/ssl:/etc/ssl/mealie:ro

# General
Environment="TZ={{ site['timezone'] }}"
Environment="BASE_URL=https://{{ services['containers']['mealie']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
Environment="ALLOW_PASSWORD_LOGIN=false"

# Database (PostgreSQL)
Environment="DB_ENGINE=postgres"
Environment="POSTGRES_SERVER={{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}"
Environment="POSTGRES_PORT={{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}"
Environment="POSTGRES_USER=mealie"
Environment="POSTGRES_DB=mealie_db"
Environment="PGSSLMODE=verify-full"
Environment="PGSSLROOTCERT=/etc/ssl/mealie/{{ site['ca']['x509']['root']['certificate_file'] }}"
Secret=MEALIE_POSTGRES_PASSWORD,type=env,target=POSTGRES_PASSWORD

# OIDC
Environment="OIDC_AUTH_ENABLED=true"
Environment="OIDC_SIGNUP_ENABLED=true"
Environment="OIDC_CONFIGURATION_URL=https://{{ services['containers']['authelia']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}/.well-known/openid-configuration"
Environment="OIDC_CLIENT_ID=mealie"
Environment="OIDC_AUTO_REDIRECT=false"
Environment="OIDC_ADMIN_GROUP=admins"
Environment="OIDC_USER_GROUP=users"
Secret=MEALIE_OIDC_CLIENT_SECRET,type=env,target=OIDC_CLIENT_SECRET

[Service]
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
