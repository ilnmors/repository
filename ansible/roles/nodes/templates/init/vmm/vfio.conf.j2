{% set vfio_devices = (hardwares['vmm']['gpu'] | dict2items) + (hardwares['vmm']['audio'] | default({}) | dict2items) %}
options vfio-pci ids={{ vfio_devices | map(attribute='value.id') | reject('equalto', none) | join(',') }}
{% for driver in vfio_devices | map(attribute='value.driver') | select | unique %}
softdep {{ driver }} pre: vfio-pci
{% endfor %}
