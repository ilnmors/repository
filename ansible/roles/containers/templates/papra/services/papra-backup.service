[Unit]
Description=Papra sqlite backup
Requires=papra.service
After=papra.service

[Service]
Type=oneshot
ExecStart=/usr/bin/podman exec -u nonroot papra node --input-type=module -e '\
        import { createClient } from "@libsql/client"; \
        import { rename, copyFile, rm } from "node:fs/promises"; \
        const databaseUrl = "file:/app/app-data/db/db.sqlite"; \
        const backupDir = "/app/backup"; \
        const now = new Date(); \
        const date = [ \
            now.getFullYear(), \
            String(now.getMonth() + 1).padStart(2, "0"), \
            String(now.getDate()).padStart(2, "0"), \
        ].join("-"); \
        const dst = backupDir + "/db.sqlite"; \
        const dated_dst = backupDir + "/db_" + date + ".sqlite"; \
        const tmp = dst + ".tmp"; \
        let completed = false; \
        try { \
            await rm(tmp, { force: true }); \
            const db = createClient({ url: databaseUrl }); \
            try { \
                await db.execute({ \
                    sql: "VACUUM INTO ?", \
                    args: [tmp], \
                }); \
            } finally { \
                db.close(); \
            } \
            await rename(tmp, dst); \
            await copyFile(dst, dated_dst); \
            completed = true; \
        } finally { \
            if (!completed) { \
                await rm(tmp, { force: true }); \
            } \
        }'
ExecStart=/usr/bin/podman exec -u nonroot papra sh -c "find /app/backup/ -maxdepth 1 -type f -name 'db_*.sqlite' -mtime +7 -delete"
