[Quadlet]
DefaultDependencies=false

[Unit]
Description=Caddy

{% if target_host in (services['containers']['step-ca']['units']['main']['hosts']) %}
After=step-ca.service
Requires=step-ca.service
{% else %}
After=network-online.target
Wants=network-online.target
{% endif %}


[Container]
Image={{ containers_container_repository }}:{{ releases['containers']['caddy']['tag'] }}

ContainerName=caddy_{{ target_host }}
HostName=caddy_{{ target_host }}
{% if target_host in (services['containers']['step-ca']['units']['main']['hosts']) %}
AddHost={{ services['containers']['step-ca']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}:host-gateway
{% endif %}
{% if target_host in services['containers']['prometheus']['units']['main']['hosts'] %}
AddHost={{ services['containers']['prometheus']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}:host-gateway
{% endif %}
{% if target_host in services['containers']['loki']['units']['main']['hosts'] %}
AddHost={{ services['containers']['loki']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}:host-gateway
{% endif %}

PublishPort={{ services['containers'][target_container]['units']['main']['ports']['http']['int'] }}:{{ services['containers'][target_container]['units']['main']['ports']['http']['container'] }}/{{ services['containers'][target_container]['units']['main']['ports']['http']['protocol'] }}
PublishPort={{ services['containers'][target_container]['units']['main']['ports']['https']['int'] }}:{{ services['containers'][target_container]['units']['main']['ports']['https']['container'] }}/{{ services['containers'][target_container]['units']['main']['ports']['https']['protocol'] }}

Volume=%h/containers/caddy/etc:/etc/caddy:ro
Volume=%h/containers/caddy/data:/data:rw
{% if 
    target_host in (services['containers'][target_container]['units']['main']['build']['http-bouncer']['hosts'])
    and 
    target_host in (services['containers'][target_container]['units']['main']['build']['crowdsec-bouncer']['hosts']) 
%}
Volume=/var/log/caddy:/log:rw
{% endif %}

Environment="TZ={{ site['timezone'] }}"

Secret=CADDY_ACME_KEY,target=/run/secrets/CADDY_ACME_KEY
{% if target_host in services['containers'][target_container]['units']['main']['build']['http-bouncer']['hosts'] and target_host in services['containers'][target_container]['units']['main']['build']['crowdsec-bouncer']['hosts'] %}
Secret=CADDY_CROWDSEC_KEY,target=/run/secrets/CADDY_CROWDSEC_KEY
{% endif %}

[Service]
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
