[Quadlet]
DefaultDependencies=false

[Unit]
Description=Snappymail

After=network-online.target
Wants=network-online.target

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}
ContainerName=snappymail
HostName=snappymail

PublishPort={{ services['containers']['snappymail']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['snappymail']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['snappymail']['units']['main']['ports']['http']['protocol'] }}

Volume={{ nodes[target_host]['paths']['data'] }}/containers/snappymail/data:/var/lib/snappymail:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/snappymail/ssl:/etc/ssl/snappymail:ro
Volume={{ nodes[target_host]['paths']['home'] }}/containers/snappymail/configs:/var/lib/snappymail/_data_/_default_/configs:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/snappymail/domains:/var/lib/snappymail/_data_/_default_/domains:rw

# General
Environment="TZ={{ site['timezone'] }}"

[Service]
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['postfix']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['postfix']['units']['main']['ports']['submission']['ext'] }}
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['dovecot']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['dovecot']['units']['main']['ports']['imaps']['ext'] }}
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
