{% set prometheus = services['containers']['prometheus']['units']['main'] %}
# Alloy pushes every other series through remote write (--web.enable-remote-write-receiver).
# Alert rules are evaluated by Grafana (grafana/etc/provisioning/alerting).
global:
  scrape_interval: 15s
  scrape_timeout: 10s

scrape_configs:
  - job_name: "prometheus"
    scheme: "https"
    tls_config:
      ca_file: "/etc/ssl/prometheus/{{ site['ca']['x509']['root']['certificate_file'] }}"
      server_name: "{{ prometheus['domain']['internal'] }}.{{ site['domain']['internal'] }}"
    static_configs:
      - targets: ["{{ prometheus['domain']['internal'] }}.{{ site['domain']['internal'] }}:{{ prometheus['ports']['https']['int'] }}"]
        labels:
          instance: "{{ target_host }}"
