---
auth_enabled: true

server:
  http_listen_address: "::"
  http_listen_port: {{ services['containers']['loki']['units']['main']['ports']['https']['container'] }}
  http_tls_config:
    cert_file: /etc/ssl/loki/{{ services['containers']['loki']['units']['main']['domain']['internal'] }}.crt
    key_file: /etc/ssl/loki/{{ services['containers']['loki']['units']['main']['domain']['internal'] }}.key

ruler:
  enable_api: true
  rule_path: /loki/rules
  storage:
    type: local
    local:
      directory: /etc/loki/rules

schema_config:
  configs:
    - from: "2023-01-01"
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: 180d
  reject_old_samples: true
  reject_old_samples_max_age: 168h

common:
  instance_addr: localhost
  path_prefix: /loki
  replication_factor: 1
  storage:
    filesystem:
      chunks_directory: /loki/chunks
      rules_directory: /loki/rules
  ring:
    kvstore:
      store: inmemory

compactor:
  working_directory: /loki/compactor
  delete_request_store: filesystem
  compaction_interval: 10m
  retention_enabled: true
  retention_delete_delay: 2h
