[Quadlet]
DefaultDependencies=false

[Unit]
Description=x509-Exporter

After=network-online.target
Wants=network-online.target

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=x509-exporter
HostName=x509-exporter

PublishPort={{ services['containers'][target_container]['units']['main']['ports']['http']['int'] }}:{{ services['containers'][target_container]['units']['main']['ports']['http']['container'] }}/{{ services['containers'][target_container]['units']['main']['ports']['http']['protocol'] }}

Volume={{ nodes[target_host]['paths']['home'] }}/containers/x509-exporter/config/config.yaml:/etc/config.yaml:ro
Volume={{ nodes[target_host]['paths']['home'] }}/containers/x509-exporter/certs:/certs:ro

Environment="TZ={{ site['timezone'] }}"

Exec=--config /etc/config.yaml

[Service]
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
