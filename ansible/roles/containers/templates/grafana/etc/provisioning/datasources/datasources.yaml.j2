{% set prometheus = services['containers']['prometheus']['units']['main'] %}
{% set loki = services['containers']['loki']['units']['main'] %}
# https://github.com/grafana/grafana/blob/main/conf/provisioning/datasources/sample.yaml
apiVersion: 1

datasources:
  - name: Prometheus
    uid: PBFA97CFB590B2093
    type: prometheus
    url: https://{{ prometheus['domain']['internal'] }}.{{ site['domain']['internal'] }}:{{ prometheus['ports']['https']['int'] }}
    access: proxy
    isDefault: true
    jsonData:
      tlsAuth: false
      tlsAuthWithCACert: true
      httpMethod: POST
      # Alloy scrapes every 60 s; $__rate_interval is derived from this.
      timeInterval: 60s
    secureJsonData:
      tlsCACert: "$__file{/etc/ssl/grafana/{{ site['ca']['x509']['root']['certificate_file'] }}}"

  - name: Loki
    uid: P8E80F9AEF21F6940
    type: loki
    url: https://{{ loki['domain']['internal'] }}.{{ site['domain']['internal'] }}:{{ loki['ports']['https']['int'] }}
    access: proxy
    jsonData:
      tlsAuth: false
      tlsAuthWithCACert: true
      # The Loki tenant (same as the alloy loki.write tenant_id).
      httpHeaderName1: "X-Scope-OrgID"
      maxLines: 1000
    secureJsonData:
      tlsCACert: "$__file{/etc/ssl/grafana/{{ site['ca']['x509']['root']['certificate_file'] }}}"
      httpHeaderValue1: "{{ site['domain']['internal'] }}"
