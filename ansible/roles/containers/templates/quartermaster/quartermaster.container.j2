[Quadlet]
DefaultDependencies=false

[Unit]
Description=Quartermaster

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=quartermaster
HostName=quartermaster

PublishPort={{ services['containers']['quartermaster']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['quartermaster']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['quartermaster']['units']['main']['ports']['http']['protocol'] }}

# GPU access for Vulkan
AddDevice=/dev/dri:/dev/dri
PodmanArgs=--group-add keep-groups

Volume={{ nodes[target_host]['paths']['home'] }}/containers/quartermaster/data:/data:rw
# Downloaded from the dashboard's model hub; they can be fetched again, so they stay out of DATA and its backups.
Volume={{ nodes[target_host]['paths']['home'] }}/containers/quartermaster/models:/data/models:rw

Environment="TZ={{ site['timezone'] }}"
# The image entrypoint seeds the autogen control file on first start.
Environment="QM_GENERATE_FILE=/data/quartermaster-generate.yaml"

# Generate mode: models, settings and per-model commands are managed in the dashboard, which
# regenerates and hot-reloads /data/config.yaml. Naming only -config would freeze it as written.
Exec=-config /data/config.yaml -generate /data/quartermaster-generate.yaml -models-dir /data/models -listen 0.0.0.0:{{ services['containers']['quartermaster']['units']['main']['ports']['http']['container'] }} -admin-open

[Service]
Restart=always
RestartSec=60s
TimeoutStopSec=300

[Install]
WantedBy=default.target
