[Quadlet]
DefaultDependencies=false

[Unit]
Description=Quartermaster

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=quartermaster
HostName=quartermaster

PublishPort={{ services['containers']['quartermaster']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['quartermaster']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['quartermaster']['units']['main']['ports']['http']['protocol'] }}

# GPU access for Vulkan
AddDevice=/dev/dri:/dev/dri
PodmanArgs=--group-add keep-groups

Volume={{ nodes[target_host]['paths']['home'] }}/containers/quartermaster/data:/data:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/quartermaster/config:/data/config:ro
Volume={{ nodes[target_host]['paths']['home'] }}/containers/quartermaster/models:/data/models:ro

Environment="TZ={{ site['timezone'] }}"
# The container is recreated on every start; keeping the Mesa (RADV) shader cache in /data saves the
# shader compilation that otherwise doubles the first model load after a restart.
Environment="MESA_SHADER_CACHE_DIR=/data/cache/mesa"
Environment="MESA_SHADER_CACHE_MAX_SIZE=4G"
# The image entrypoint seeds its autogen file on first start; keep it out of the read-only config mount.
Environment="QM_GENERATE_FILE=/data/quartermaster-generate.yaml"

# Models and their commands come from Ansible: without -generate the config is loaded as written.
Exec=-config /data/config/config.yaml -listen 0.0.0.0:{{ services['containers']['quartermaster']['units']['main']['ports']['http']['container'] }} -admin-open

[Service]
Restart=always
RestartSec=60s
TimeoutStopSec=300

[Install]
WantedBy=default.target
