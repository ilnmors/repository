{% set qm = releases['containers']['quartermaster'] %}
{% set sd_tag = qm['build']['sd_server']['tag'] %}
{% set llama_tag = qm['build']['llama_server']['tag'] %}
{% set strata = qm['build']['strata'] %}
FROM {{ qm['repository'] }}:{{ qm['tag'] }} AS upstream

# Strata: the launcher (/opt/strata/terminal, with its own Python) and the engine with its ROCm libraries need only
# glibc and libstdc++ from the system. The entrypoint is kept for its settings, tuning and clean stop, with two
# changes: it serves on loopback only (inside this container quartermaster is the only client, so no API key),
# and its state lives in /data/strata (settings in DATA, packs and drafter on the NVMe disk; see the container file).
FROM {{ strata['repository'] }}:{{ strata['tag'] }} AS strata
RUN sed -i -e 's#--access lan#--access local#' -e 's#/data/#/data/strata/#g' -e 's# /data # /data/strata #g' \
      /opt/strata/entrypoint.sh && \
    grep -q -- '--access local' /opt/strata/entrypoint.sh && \
    ! grep -q -- '--access lan' /opt/strata/entrypoint.sh

# llama-server release archive: llama-<tag>-bin-ubuntu-vulkan-x64.tar.gz holds llama-<tag>/.
FROM docker.io/library/ubuntu:{{ qm['build']['base']['tag'] }} AS llama-server
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*
RUN mkdir -p /out && \
    curl -fsSL https://github.com/ggml-org/llama.cpp/releases/download/{{ llama_tag }}/llama-{{ llama_tag }}-bin-ubuntu-vulkan-x64.tar.gz \
      | tar -xz -C /out
# Quartermaster adopts a backend directory only when it holds this install record.
RUN printf '%s\n' \
      '{' \
      '  "component": "llama-server",' \
      '  "version": "{{ llama_tag }}",' \
      '  "variant": "vulkan",' \
      '  "exe": "llama-{{ llama_tag }}/llama-server",' \
      '  "asset": "llama-{{ llama_tag }}-bin-ubuntu-vulkan-x64.tar.gz",' \
      '  "installedAt": "1970-01-01T00:00:00Z",' \
      '  "sizeBytes": 0' \
      '}' > /out/.qm-install.json

# sd-server release zip: sd-master-<commit>-bin-Linux-Ubuntu-<base>-x86_64-vulkan.zip, extracted flat.
FROM docker.io/library/ubuntu:{{ qm['build']['base']['tag'] }} AS sd-server
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl unzip && \
    rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/sd-server.zip \
      https://github.com/leejet/stable-diffusion.cpp/releases/download/{{ sd_tag }}/sd-master-{{ sd_tag.split('-') | last }}-bin-Linux-Ubuntu-{{ qm['build']['base']['tag'] }}-x86_64-vulkan.zip && \
    unzip -q /tmp/sd-server.zip -d /out && \
    chmod 0755 /out/sd-server /out/sd-cli
# Quartermaster adopts a backend directory only when it holds this install record.
RUN printf '%s\n' \
      '{' \
      '  "component": "sd-server",' \
      '  "version": "{{ sd_tag }}",' \
      '  "variant": "vulkan",' \
      '  "exe": "sd-server",' \
      '  "asset": "sd-master-{{ sd_tag.split('-') | last }}-bin-Linux-Ubuntu-{{ qm['build']['base']['tag'] }}-x86_64-vulkan.zip",' \
      '  "installedAt": "1970-01-01T00:00:00Z",' \
      '  "sizeBytes": 0' \
      '}' > /out/.qm-install.json

# Same runtime as upstream (Ubuntu, ca-certificates, libgomp1, libvulkan1) plus the Mesa Vulkan drivers, and Python
# with Pillow for the video adapter (roles/containers/templates/quartermaster/video/adapter.py, mounted at run time).
FROM docker.io/library/ubuntu:{{ qm['build']['base']['tag'] }}
ENV DEBIAN_FRONTEND=noninteractive
ENV QM_BACKENDS_DIR=/opt/quartermaster/backends
RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates libgomp1 libvulkan1 mesa-vulkan-drivers \
      python3 python3-pil && \
    rm -rf /var/lib/apt/lists/*
COPY --from=upstream /usr/local/bin/quartermaster /usr/local/bin/entrypoint.sh /usr/local/bin/
COPY --from=llama-server /out /opt/quartermaster/backends/bin/llama-server/{{ llama_tag }}-vulkan
# The binaries carry RUNPATH $ORIGIN, so the bundled ggml libraries next to them are found.
COPY --from=sd-server /out /opt/quartermaster/backends/bin/sd-server/{{ sd_tag }}-vulkan
# Same path as in the Strata image: its saved run settings name engine files under /opt/strata/components.
COPY --from=strata /opt/strata /opt/strata
COPY qm-entrypoint.sh /usr/local/bin/qm-entrypoint.sh
RUN chmod 0755 /usr/local/bin/qm-entrypoint.sh && mkdir -p /data/config /data/models
WORKDIR /data
ENTRYPOINT ["/usr/local/bin/qm-entrypoint.sh"]
CMD ["-generate", "/data/config/quartermaster-generate.yaml", "-config", "/data/config/config.yaml", "-listen", "0.0.0.0:8080", "-admin-open"]
