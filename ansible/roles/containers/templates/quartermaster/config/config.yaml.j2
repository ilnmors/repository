# Quartermaster (llama-swap style) config.
# llama-server and sd-server are bundled in the image under /opt/quartermaster/backends;
# their versions and paths follow releases.yaml (build.llama_server, build.sd_server).
# The model files are listed in ../models.yaml, synced from DATA to HOME and mounted at /data/models/<model>/;
# containers_quartermaster_files maps each model and role (model, mmproj, mtp, ...) to its path.
{% set qm = containers_quartermaster_files %}
# Open WebUI refers to these model ids through services.containers.openwebui.units.main.ai.
#
# Devices as llama-server lists them: Vulkan0 is the Iris Xe (shared memory), Vulkan1 the RX 7900 XT (20 GB).
# The chat model and image generation take turns on the RX 7900 XT (any two need over 20 GB); the Iris Xe
# keeps the embedding model loaded, but renders a 1024x1024 image in about ten minutes.
startPort: 5800
globalTTL: 0
# Strata loads for minutes and builds the packs of a new quant for much longer; llama-server is ready well before.
healthCheckTimeout: 7200

macros:
  llama: >-
    /opt/quartermaster/backends/bin/llama-server/{{ releases['containers']['quartermaster']['build']['llama_server']['tag'] }}-vulkan/llama-{{ releases['containers']['quartermaster']['build']['llama_server']['tag'] }}/llama-server
    --host 127.0.0.1 --port ${PORT} --n-gpu-layers 999 --kv-unified
    --cache-type-k q8_0 --cache-type-v q8_0 --flash-attn auto --jinja
    --batch-size 2048 --ubatch-size 2048
  sd: >-
    /opt/quartermaster/backends/bin/sd-server/{{ releases['containers']['quartermaster']['build']['sd_server']['tag'] }}-vulkan/sd-server
    --listen-ip 127.0.0.1 --listen-port ${PORT}

models:
  # Strata (HIP) on the RX 7900 XT: the hot experts stay in VRAM, the rest are pinned in RAM and the n-gram table
  # is read from disk. Settings measured 2026-11-20/21 (docs/operating/quartermaster): the tuned preset (tuned at 32k),
  # a 64k context for the coding clients,
  # the DFlash2 drafter, ten expert workers and an expert profile it keeps learning. Presets and profiles live in
  # /data/strata (DATA), packs and the drafter in /data/strata/Strata-data (HOME); a new quant builds its pack first.
  qwen3.8-flash-next-ista:
    env:
      - "STRATA_ALLOWED_HOSTS=host.containers.internal,{{ services['containers']['quartermaster']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}"
      - "STRATA_COMPONENTS_DIR=/opt/strata/components"
      - "STRATA_INSTALL_DIR=/data/strata/install"
      - "XDG_STATE_HOME=/data/strata/state"
      - "XDG_CONFIG_HOME=/data/strata/config"
      - "HOME=/data/strata/home"
      - "STRATA_IN_DOCKER=1"
      - "PYTHONNOUSERSITE=1"
      - "LANG=C.UTF-8"
      - "MODEL_PATH={{ qm['qwen3.8-flash-next-ista']['model'] | dirname }}"
      - "FAMILY=qwen"
      - "MODEL=IQ2_XS"
      - "PRESET=iq2xs"
      - "CONTEXT=64k"
      - "VISION=cpu"
      - "DRAFTING=dflash2"
      # The refusal-direction projection (models.yaml, role cvec) goes straight to the engine: strata launch keeps
      # setup's own experimental-speed-projection switch off for this family, and --set options are added after it.
      - "STRATA_SET=pool-workers=10 STRATA_RESIDENT_PIN=1 expert-profile=/data/strata/profile-iq2xs.bin expert-profile-save=/data/strata/profile-iq2xs.bin expert-profile-save-every=1 control-vector-scaled={{ qm['qwen3.8-flash-next-ista']['cvec'] }}:1.0 control-vector-layer-range=4-44 cvec-mode=project cvec-dir=per-layer"
    cmd: >-
      env PORT=${PORT} /opt/strata/entrypoint.sh
    proxy: "http://127.0.0.1:${PORT}"
    # Healthy once a model is loaded; loading takes minutes (hours when the packs are built the first time).
    checkEndpoint: "/v1/models"
    # Fewer Chinese words in Korean answers: every request gets logit_bias -3 on the tokens that contain a Han character
    # or a UTF-8 lead byte E4-E9 (files/quartermaster/han-token-ids.json, built from this model's tokenizer; rebuild it
    # for another model). Hangul is not touched. Tested 2026-11-22 on IQ2_XS: Korean answers with Han 9/30 -> 0/30,
    # prompts that ask for Han (hanja, Chinese, code strings) still get it (-5 starts to break that), speed unchanged.
    # A client's own logit_bias is replaced.
{% set han_ids = lookup('ansible.builtin.file', 'quartermaster/han-token-ids.json') | from_json %}
    filters:
      setParams:
        logit_bias: {{ dict(han_ids | map('string') | zip([-3] * (han_ids | length))) | to_json }}
  bge-m3:
    cmd: >-
      ${llama} --device Vulkan0
      --model {{ qm['bge-m3']['model'] }}
      --embedding --pooling cls --ctx-size 8192 --batch-size 8192 --ubatch-size 8192 --parallel 1
  qwen-image-2.1:
    # sd-server has no device option; this limits its Vulkan backend to the RX 7900 XT.
    env:
      - "GGML_VK_VISIBLE_DEVICES=1"
    # Turbo: the fixed 8-step sigma schedule at CFG 1. Everything stays in VRAM (15.9 GB peak at 1024x1024);
    # offloading to the CPU took 44.7 s instead of 26.3 s and pushed the chat models out of the page cache.
    cmd: >-
      ${sd} --diffusion-model {{ qm['qwen-image-2.1']['diffusion'] }}
      --llm {{ qm['qwen-image-2.1']['llm'] }}
      --vae {{ qm['qwen-image-2.1']['vae'] }}
      --sigmas qwen-image-2.1-turbo --steps 8 --cfg-scale 1.0 --sampling-method euler -W 1024 -H 1024
    # sd-server has no /health; /v1/models answers once the weights are loaded.
    checkEndpoint: "/v1/models"
  # Distilled to 6 steps without CFG. The 32B text encoder runs on the Iris Xe (shared memory, faster than
  # the CPU); the DiT and the VAE stay on the RX 7900 XT.
  minimax-h3-image:
    cmd: >-
      ${sd} --diffusion-model {{ qm['minimax-h3-image']['diffusion'] }}
      --llm {{ qm['minimax-h3-image']['llm'] }}
      --vae {{ qm['minimax-h3-image']['vae'] }}
      --backend te=vulkan0,diffusion=vulkan1,vae=vulkan1
      --sigmas minimax-h3-image --steps 6 --cfg-scale 1.0 --sampling-method euler --rng cpu -W 1024 -H 1024
    checkEndpoint: "/v1/models"

# The embedding model stays loaded on the Iris Xe; chat and image generation swap on the RX 7900 XT.
routing:
  router:
    use: group
    settings:
      groups:
        igpu:
          swap: false
          exclusive: false
          persistent: true
          members:
            - "bge-m3"
        dgpu:
          swap: true
          exclusive: false
          persistent: false
          members:
            - "qwen3.8-flash-next-ista"
            - "qwen-image-2.1"
            - "minimax-h3-image"

hooks:
  on_startup:
    preload:
      - "bge-m3"
      - "qwen3.8-flash-next-ista"
