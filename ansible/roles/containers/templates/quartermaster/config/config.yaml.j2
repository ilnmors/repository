# Quartermaster (llama-swap style) config.
# llama-server and sd-server are bundled in the image under /opt/quartermaster/backends;
# their versions and paths follow releases.yaml (build.llama_server, build.sd_server).
# The model files are listed in ../models.yaml, synced from DATA to HOME and mounted at /data/models/<model>/;
# containers_quartermaster_files maps each model and role (model, mmproj, mtp, ...) to its path.
{% set qm = containers_quartermaster_files %}
# Open WebUI refers to these model ids through services.containers.openwebui.units.main.ai.
#
# Devices as llama-server lists them: Vulkan0 is the Iris Xe (shared memory), Vulkan1 the RX 7900 XT (20 GB).
# The chat model and image generation take turns on the RX 7900 XT (any two need over 20 GB); the Iris Xe
# keeps the embedding model loaded, but renders a 1024x1024 image in about ten minutes.
startPort: 5800
globalTTL: 0
# Strata loads for minutes and builds the packs of a new quant for much longer; llama-server is ready well before.
healthCheckTimeout: 7200

macros:
  llama: >-
    /opt/quartermaster/backends/bin/llama-server/{{ releases['containers']['quartermaster']['build']['llama_server']['tag'] }}-vulkan/llama-{{ releases['containers']['quartermaster']['build']['llama_server']['tag'] }}/llama-server
    --host 127.0.0.1 --port ${PORT} --n-gpu-layers 999 --kv-unified
    --cache-type-k q8_0 --cache-type-v q8_0 --flash-attn auto --jinja
  sd: >-
    /opt/quartermaster/backends/bin/sd-server/{{ releases['containers']['quartermaster']['build']['sd_server']['tag'] }}-vulkan/sd-server
    --listen-ip 127.0.0.1 --listen-port ${PORT}

models:
  # Strata (HIP) on the RX 7900 XT: the hot experts stay in VRAM, the rest are pinned in RAM and the n-gram table
  # is read from disk. Settings measured 2026-11-20/21 (docs/services/quartermaster): the tuned preset (tuned at 32k),
  # a 64k context for the coding clients,
  # the DFlash2 drafter, ten expert workers and an expert profile it keeps learning. Presets and profiles live in
  # /data/strata (DATA), packs and the drafter in /data/strata/Strata-data (HOME); a new quant builds its pack first.
  qwen3.8-flash-next:
    env:
      - "STRATA_ALLOWED_HOSTS=host.containers.internal,{{ services['containers']['quartermaster']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}"
      - "STRATA_COMPONENTS_DIR=/opt/strata/components"
      - "STRATA_INSTALL_DIR=/data/strata/install"
      - "XDG_STATE_HOME=/data/strata/state"
      - "XDG_CONFIG_HOME=/data/strata/config"
      - "HOME=/data/strata/home"
      - "STRATA_IN_DOCKER=1"
      - "PYTHONNOUSERSITE=1"
      - "LANG=C.UTF-8"
      - "MODEL_PATH={{ qm['qwen3.8-flash-next']['model'] | dirname }}"
      - "FAMILY=qwen"
      - "MODEL=IQ3_XXS"
      - "PRESET=iq3"
      - "CONTEXT=64k"
      - "VISION=cpu"
      - "DRAFTING=dflash2"
      # The refusal-direction projection (models.yaml, role cvec) goes straight to the engine: strata launch keeps
      # setup's own experimental-speed-projection switch off for this family, and --set options are added after it.
      - "STRATA_SET=pool-workers=10 STRATA_RESIDENT_PIN=1 expert-profile=/data/strata/profile-iq3.bin expert-profile-save=/data/strata/profile-iq3.bin expert-profile-save-every=1 control-vector-scaled={{ qm['qwen3.8-flash-next']['cvec'] }}:1.0 control-vector-layer-range=4-44 cvec-mode=project cvec-dir=per-layer"
    cmd: >-
      env PORT=${PORT} /opt/strata/entrypoint.sh
    proxy: "http://127.0.0.1:${PORT}"
    # Healthy once a model is loaded; loading takes minutes (hours when the packs are built the first time).
    checkEndpoint: "/v1/models"
    # Fewer Chinese words in Korean answers: every request gets logit_bias -3 on the tokens that contain a Han character
    # or a UTF-8 lead byte E4-E9 (templates/quartermaster/han-token-ids.json, built from this model's tokenizer; rebuild it
    # for another model). Hangul is not touched. Tested 2026-11-22 on IQ2_XS: Korean answers with Han 9/30 -> 0/30,
    # prompts that ask for Han (hanja, Chinese, code strings) still get it (-5 starts to break that), speed unchanged.
    # A client's own logit_bias is replaced.
{% set han_ids = lookup('ansible.builtin.file', role_path ~ '/templates/quartermaster/han-token-ids.json') | from_json %}
    filters:
      setParams:
        logit_bias: {{ dict(han_ids | map('string') | zip([-3] * (han_ids | length))) | to_json }}
  bge-m3:
    cmd: >-
      ${llama} --device Vulkan0
      --model {{ qm['bge-m3']['model'] }}
      --embedding --pooling cls --ctx-size 8192 --batch-size 8192 --ubatch-size 8192 --parallel 1
  # Code tab-autocomplete (FIM) on the Iris Xe beside bge-m3; Continue on console calls /v1/completions directly.
  qwen2.5-coder-1.5b:
    cmd: >-
      ${llama} --device Vulkan0
      --model {{ qm['qwen2.5-coder-1.5b']['model'] }}
      --ctx-size 4096 --batch-size 1024 --ubatch-size 512 --parallel 1 --cache-reuse 256
  # Z-Image Turbo finetune in Q8_0 on the RX 7900 XT (6.5 GB); the Qwen3 4B text encoder runs on the Iris Xe.
  # Turbo sampling: 9 steps at CFG 1.
  {% raw %}
  # moody-pro-mix:
  #   cmd: >-
  #     ${sd} --diffusion-model {{ qm['moody-pro-mix']['diffusion'] }}
  #     --llm {{ qm['moody-pro-mix']['llm'] }}
  #     --vae {{ qm['moody-pro-mix']['vae'] }}
  #     --backend te=vulkan0,diffusion=vulkan1,vae=vulkan1
  #     --steps 9 --cfg-scale 1.0 --sampling-method euler -W 1024 -H 1024
  #   checkEndpoint: "/v1/models"
  {% endraw %}
  # Krea 2 finetune in Q8_0 on the RX 7900 XT; kept in DATA while Qwen-Image-2.1 runs.
  {% raw %}
  # moody-krea2-mix:
  #   cmd: >-
  #     ${sd} --diffusion-model {{ qm['moody-krea2-mix']['diffusion'] }}
  #     --llm {{ qm['moody-krea2-mix']['llm'] }}
  #     --vae {{ qm['moody-krea2-mix']['vae'] }}
  #     --backend te=vulkan0,diffusion=vulkan1,vae=vulkan1
  #     --steps 12 --cfg-scale 1.0 --sampling-method euler_a --scheduler beta -W 1024 -H 1024 --guidance 2.5
  #   checkEndpoint: "/v1/models"
  {% endraw %}
  # Qwen-Image-2.1 Uncensored Omni in Q8_0 with its BF16 VAE, abliterated Qwen3-VL-8B Q6_K, and F16 vision projector
  # for all-in-one T2I + native multi-reference I2I editing. All modules compute on the RX 7900 XT (vulkan1) with
  # --offload-to-cpu so weights reside in system RAM (~38 GiB free while chat is unloaded) and stream per stage without
  # 20 GB VRAM OOM; this cuts native I2I time in half vs te=vulkan0 (63.5 s -> 30.8 s). Passing the 8-step Turbo LoRA
  # tag in --prompt populates default_gen_params.lora_map at startup, so every /v1/images/generations and
  # /v1/images/edits request inherits it automatically at 8 steps, CFG 1.0 (keep VAE tiling off to avoid streaks).
  qwen-image-2.1:
    cmd: >-
      ${sd} --diffusion-model {{ qm['qwen-image-2.1']['diffusion'] }}
      --llm {{ qm['qwen-image-2.1']['llm'] }}
      --llm_vision {{ qm['qwen-image-2.1']['llm_vision'] }}
      --vae {{ qm['qwen-image-2.1']['vae'] }}
      --lora-model-dir {{ qm['qwen-image-2.1']['diffusion'] | dirname }}/loras
      --lora-apply-mode auto
      --backend te=vulkan1,diffusion=vulkan1,vae=vulkan1
      --offload-to-cpu
      --flash-attn off,diffusion=on
      --sampling-method euler --steps 8 --cfg-scale 1.0 -W 1024 -H 1024
      --prompt "<lora:chatrlabs-omni-turbo-8step-fp32:1.0>"
    checkEndpoint: "/v1/models"
  # Image to video (the /v1/videos adapter returns animated WebP). WAN 2.2 Enhanced NSFW, Lightning Edition: Wan 2.2
  # I2V A14B with the Lightning distillation baked in, a high-noise and a low-noise transformer (Q8_0, 15 GB each) that
  # take turns on the RX 7900 XT; umT5-XXL runs on the Iris Xe. The author's settings: 2+3 steps (2 high-noise, 3
  # low-noise), Euler/simple, CFG 1 in both stages (the high-noise stage defaults to 7). Measured 2026-11-23 on a 3 s
  # clip (49 frames): 624x624 4+4 steps 353 s, 624x624 2+2 205 s, 512x512 2+3 140 s, so clips default to about 512x512
  # worth of pixels (672x384, or the start image's shape at that area).
  # <! NOTICE !>
  # When sd-server is upgraded, check the deprecated parameters
  # 532d2c1 to 0d71f96
  # --high-noise-sampling-method euler --high-noise-cfg-scale 1.0 are deprecated.
  wan2.2-enhanced-i2v:
    cmd: >-
      ${sd} --diffusion-model {{ qm['wan2.2-enhanced-i2v']['diffusion'] }}
      --high-noise-diffusion-model {{ qm['wan2.2-enhanced-i2v']['high_noise'] }}
      --t5xxl {{ qm['wan2.2-enhanced-i2v']['t5xxl'] }}
      --vae {{ qm['wan2.2-enhanced-i2v']['vae'] }}
      --backend te=vulkan0,diffusion=vulkan1,vae=vulkan1
      --steps 3 --high-noise-steps 2 --cfg-scale 1.0
      --sampling-method euler --scheduler simple --params-backend disk
      --video-frames 49 --fps 16 -W 672 -H 384 --vae-tiling --temporal-tiling
    checkEndpoint: "/v1/models"

# The embedding and autocomplete models stay loaded on the Iris Xe; chat and image/video swap on the RX 7900 XT.
routing:
  router:
    use: group
    settings:
      groups:
        igpu:
          swap: false
          exclusive: false
          persistent: true
          members:
            - "bge-m3"
            - "qwen2.5-coder-1.5b"
        dgpu:
          swap: true
          exclusive: false
          persistent: false
          members:
            - "qwen3.8-flash-next"
            - "qwen-image-2.1"
            - "wan2.2-enhanced-i2v"
#           - "moody-krea2-mix"
#           - "moody-pro-mix"

hooks:
  on_startup:
    preload:
      - "bge-m3"
      - "qwen2.5-coder-1.5b"
      - "qwen3.8-flash-next"
