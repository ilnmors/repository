[Unit]
Description=PostgreSQL Data %i Backup Service
After=postgresql.service
BindsTo=postgresql.service

[Service]
Type=oneshot

# logging
StandardOutput=journal
StandardError=journal

ExecStartPre=/usr/bin/podman exec postgresql sh -c "mkdir -p /backups/%i && chown postgres:root /backups/%i && chmod 770 /backups/%i"
ExecStartPre=/usr/bin/podman exec postgresql sh -c "mkdir -p /backups/sql && chown postgres:root /backups/sql && chmod 770 /backups/sql"

# Run the script
ExecStart=/usr/bin/podman exec -u postgres postgresql sh -ec '\
        backup="/backups/%i/pg_%i_$$(date "+%%Y-%%m-%%d").sql"; \
        printf "\\connect %i_db\n" > "$${backup}"; \
        printf "SET session_replication_role = replica;\n" >> "$${backup}"; \
        pg_dump -U postgres -d %i_db --data-only >> "$${backup}"; \
        printf "SET session_replication_role = origin;\n" >> "$${backup}"; \
        cp -a "$${backup}" /backups/sql/pg_%i.sql.tmp; \
        mv -f /backups/sql/pg_%i.sql.tmp /backups/sql/pg_%i.sql'
ExecStart=/usr/bin/podman exec -u postgres postgresql sh -c "find /backups/%i -maxdepth 1 -type f -name 'pg_%i_*.sql' -mtime +7 -delete"
ExecStart=/usr/bin/podman exec postgresql sh -c "chown -R postgres:root /backups/%i && chmod 660 /backups/%i/*"
ExecStart=/usr/bin/podman exec postgresql sh -c "chown -R postgres:root /backups/sql && chmod 660 /backups/sql/pg_%i.sql"
