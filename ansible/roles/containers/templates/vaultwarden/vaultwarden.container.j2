[Quadlet]
DefaultDependencies=false

[Unit]
Description=Vaultwarden

After=network-online.target
Wants=network-online.target

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=vaultwarden
HostName=vaultwarden

PublishPort={{ services['containers']['vaultwarden']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['vaultwarden']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['vaultwarden']['units']['main']['ports']['http']['protocol'] }}

Volume={{ nodes[target_host]['paths']['data'] }}/containers/vaultwarden/data:/data:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/vaultwarden/ssl:/etc/ssl/vaultwarden:ro

Environment="TZ={{ site['timezone'] }}"
Environment="DOMAIN=https://{{ services['containers']['vaultwarden']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
Environment="SIGNUPS_ALLOWED=false"
{% set postfix = services['containers']['postfix']['units']['main'] %}
# Mail goes through postfix as the vaultwarden LDAP account (services group, send only).
# OpenSSL reads the internal root CA from SSL_CERT_FILE and the public CAs from /etc/ssl/certs.
Environment="SMTP_HOST={{ postfix['domain']['internal'] }}.{{ site['domain']['internal'] }}"
Environment="SMTP_PORT={{ postfix['ports']['submission']['int'] if target_host in postfix['hosts'] else postfix['ports']['submission']['ext'] }}"
Environment="SMTP_SECURITY=starttls"
Environment="SMTP_FROM=vaultwarden@{{ site['domain']['internal'] }}"
Environment="SMTP_FROM_NAME=Vaultwarden"
Environment="SMTP_USERNAME=vaultwarden"
Environment="SMTP_AUTH_MECHANISM=Plain"
Environment="HELO_NAME={{ services['containers']['vaultwarden']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
Environment="SSL_CERT_FILE=/etc/ssl/vaultwarden/{{ site['ca']['x509']['root']['certificate_file'] }}"
Secret=VW_SMTP_PASSWORD,type=env,target=SMTP_PASSWORD
Secret=VW_ADMIN_TOKEN,type=env,target=ADMIN_TOKEN
Secret=VW_DATABASE_URL,type=env,target=DATABASE_URL

[Service]
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
