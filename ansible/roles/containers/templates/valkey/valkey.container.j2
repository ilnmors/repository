[Quadlet]
DefaultDependencies=false

[Unit]
Description=Valkey - {{ containers_valkey_service }}

After=network-online.target
Wants=network-online.target

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=valkey_{{ containers_valkey_service }}
HostName=valkey_{{ containers_valkey_service }}

PublishPort={{ services['containers'][containers_valkey_service]['units']['valkey']['ports']['tcp']['int'] }}:{{ services['containers'][containers_valkey_service]['units']['valkey']['ports']['tcp']['container'] }}/{{ services['containers'][containers_valkey_service]['units']['valkey']['ports']['tcp']['protocol'] }}

Volume={{ nodes[target_host]['paths']['home'] }}/containers/valkey/{{ containers_valkey_service }}/data:/data:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/valkey/{{ containers_valkey_service }}/valkey.conf:/usr/local/etc/valkey/valkey.conf:ro

Exec=valkey-server /usr/local/etc/valkey/valkey.conf

Environment="TZ={{ site['timezone'] }}"

[Service]
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
