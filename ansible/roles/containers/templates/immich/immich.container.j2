[Quadlet]
DefaultDependencies=false

[Unit]
Description=Immich

After=valkey_immich.service
Wants=valkey_immich.service

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=immich
HostName=immich

PublishPort={{ services['containers']['immich']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['immich']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['immich']['units']['main']['ports']['http']['protocol'] }}

# iGPU access
AddDevice=/dev/dri:/dev/dri
PodmanArgs=--group-add keep-groups

# Volumes
Volume={{ nodes[target_host]['paths']['data'] }}/containers/immich/data:/data:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/immich/ssl:/etc/ssl/immich:ro

# Environment
Environment="TZ={{ site['timezone'] }}"
# The new environment from version 2.7.0 to enable CSP
Environment="IMMICH_HELMET_FILE=true"
Environment="IMMICH_TRUSTED_PROXIES={{ containers_trusted_proxies | join(',') }}"

# Redis
Environment="REDIS_HOSTNAME=host.containers.internal"
Environment="REDIS_PORT={{ services['containers']['immich']['units']['valkey']['ports']['tcp']['int'] }}"
Environment="REDIS_DBINDEX=0"

# Database
Environment="DB_HOSTNAME={{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}"
Environment="DB_PORT={{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}"
Environment="DB_USERNAME=immich"
Environment="DB_DATABASE_NAME=immich_db"
Environment="DB_PASSWORD_FILE=/run/secrets/DB_PASSWORD"
Environment="DB_SSL_MODE=verify-full"
Environment="NODE_EXTRA_CA_CERTS=/etc/ssl/immich/{{ site['ca']['x509']['root']['certificate_file'] }}"
Secret=IMMICH_DB_PASSWORD,target=/run/secrets/DB_PASSWORD

[Service]
ExecStartPre=/usr/bin/nc -zv -w 5 127.0.0.1 {{ services['containers']['immich']['units']['valkey']['ports']['tcp']['int'] }}
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
