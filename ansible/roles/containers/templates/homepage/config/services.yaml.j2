{% for group, members in containers_homepage_catalog.items() %}
- {{ group }}:
{% for key, card in members.items() %}
{% set unit = services['containers'][key]['units']['main'] %}
    - {{ card['name'] }}:
        icon: {{ card['icon'] }}
        description: {{ card['description'] }}
        href: https://{{ unit['domain']['public'] }}.{{ site['domain']['public'] }}
        siteMonitor: http://host.containers.internal:{{ unit['ports']['http']['int'] }}
{% endfor %}
{% endfor %}
- Admin:
{% for item in containers_service_list
  | selectattr('value.units.main', 'defined')
  | selectattr('value.units.main.dependency.web.status', 'defined')
  | selectattr('value.units.main.dependency.web.status', 'equalto', true)
%}
{% if (item['value']['units']['main']['domain']['public'] | default('', true) | length) == 0 %}
    - {{ item['key'] }}:
        icon: {{ {'ldap': 'lldap'}.get(item['key'], item['key']) }}
        href: https://{{ item['value']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}
{% endif %}
{% endfor %}
