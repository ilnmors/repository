[Quadlet]
DefaultDependencies=false

[Unit]
Description=OxiCloud

After=network-online.target
Wants=network-online.target

[Container]
Image={{ containers_container_repository }}:{{ releases['containers'][target_container]['tag'] }}

ContainerName=oxicloud
HostName=oxicloud

PublishPort={{ services['containers']['oxicloud']['units']['main']['ports']['http']['int'] }}:{{ services['containers']['oxicloud']['units']['main']['ports']['http']['container'] }}/{{ services['containers']['oxicloud']['units']['main']['ports']['http']['protocol'] }}

Volume={{ nodes[target_host]['paths']['data'] }}/containers/oxicloud/storage:/app/storage:rw
Volume={{ nodes[target_host]['paths']['home'] }}/containers/oxicloud/ssl:/etc/ssl/oxicloud:ro

# Storage stays on the app host's local HDD.
# Optional S3-compatible target: create the bucket, user and Podman secret first.
# Keep the local entry and use OxiCloud's migration workflow for existing data.
# Environment="OXICLOUD_STORAGE_ENTRIES=default,rustfs"
# Environment="OXICLOUD_STORAGE_default_BACKEND=local"
# Environment="OXICLOUD_STORAGE_default_ROOT_DIR=/app/storage"
# Environment="OXICLOUD_STORAGE_rustfs_BACKEND=s3"
# Environment="OXICLOUD_STORAGE_rustfs_S3_BUCKET=oxicloud"
# Environment="OXICLOUD_STORAGE_rustfs_S3_REGION=us-east-1"
# Environment="OXICLOUD_STORAGE_rustfs_S3_ENDPOINT_URL=https://{{ services['containers']['rustfs']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
# Environment="OXICLOUD_STORAGE_rustfs_S3_ACCESS_KEY=oxicloud"
# Environment="OXICLOUD_STORAGE_rustfs_S3_FORCE_PATH_STYLE=true"
# Secret=OXICLOUD_S3_SECRET_KEY,type=env,target=OXICLOUD_STORAGE_rustfs_S3_SECRET_KEY

# General
Environment="TZ={{ site['timezone'] }}"
# The image listens on 127.0.0.1 by default; PublishPort needs all interfaces.
Environment="OXICLOUD_SERVER_HOST=0.0.0.0"
Environment="OXICLOUD_BASE_URL=https://{{ services['containers']['oxicloud']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
Environment="OXICLOUD_TRUST_PROXY_CIDR={{ containers_trusted_proxies | map('regex_replace', '^([^:]+)$', '\\1/32') | map('regex_replace', '^(.*:.*)$', '\\1/128') | join(',') }}"
Secret=OXICLOUD_JWT_SECRET,type=env,target=OXICLOUD_JWT_SECRET

# PostgreSQL
Secret=OXICLOUD_DB_CONNECTION_STRING,type=env,target=OXICLOUD_DB_CONNECTION_STRING

# OIDC (DAV clients use the app passwords from Profile > App Passwords)
Environment="OXICLOUD_AUTH_METHODS=oidc"
Environment="OXICLOUD_OIDC_ENABLED=true"
Environment="OXICLOUD_OIDC_ISSUER_URL=https://{{ services['containers']['authelia']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
Environment="OXICLOUD_OIDC_CLIENT_ID=oxicloud"
Environment="OXICLOUD_OIDC_REDIRECT_URI=https://{{ services['containers']['oxicloud']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}/api/auth/oidc/callback"
Environment="OXICLOUD_OIDC_FRONTEND_URL=https://{{ services['containers']['oxicloud']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"
Environment="OXICLOUD_OIDC_SCOPES=openid profile email groups"
Environment="OXICLOUD_OIDC_ADMIN_GROUPS=admins"
# The first OIDC login creates the account, so no local admin setup is needed.
# OIDC provisioning falls back to user_<sub> for usernames shorter than 3 characters,
# although the user entity and DB accept 2-64. Rename such accounts to the LDAP id
# in auth.users.username after their first login.
Environment="OXICLOUD_OIDC_AUTO_PROVISION=true"
Environment="OXICLOUD_OIDC_PROVIDER_NAME=Authelia"
Secret=OXICLOUD_OIDC_CLIENT_SECRET,type=env,target=OXICLOUD_OIDC_CLIENT_SECRET

# WOPI (Collabora)
Environment="OXICLOUD_WOPI_ENABLED=true"
Environment="OXICLOUD_WOPI_DISCOVERY_URL=http://host.containers.internal:{{ services['containers']['collabora']['units']['main']['ports']['http']['int'] }}/hosting/discovery"
Environment="OXICLOUD_WOPI_PUBLIC_BASE_URL=https://{{ services['containers']['oxicloud']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}"

[Service]
ExecStartPre=/usr/bin/nc -zv {{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }} {{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}
Restart=always
RestartSec=60s
TimeoutStopSec=120

[Install]
WantedBy=default.target
