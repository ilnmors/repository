[Unit]
Description=Kopia backup service
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0
RequiresMountsFor={{ packages_kopia_backup_path }}

[Service]
Type=oneshot
Restart=on-failure
RestartSec=5min
User={{ nodes[target_host]['user'] }}
Group={{ nodes[target_host]['group'] }}

# logging
StandardOutput=journal
StandardError=journal

CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

ProtectSystem=strict
ProtectHome=tmpfs
InaccessiblePaths=/boot /root

BindReadOnlyPaths={{ packages_kopia_backup_path }}

# In root namescope, %u always bring 0
BindPaths=/etc/kopia
BindPaths=/var/cache/kopia
EnvironmentFile=/etc/kopia/kopia.env

ExecStartPre=/usr/bin/kopia repository connect server \
    --url=https://{{ services['packages']['kopia']['units']['server']['domain']['internal'] }}.{{ site['domain']['internal'] }}:{{ services['packages']['kopia']['units']['server']['ports']['http']['int'] }} \
    --override-username={{ target_host }} \
    --override-hostname={{ target_host }}.{{ site['domain']['internal'] }}

{% if (packages_kopia_snapshot_root | length) > 0 %}
# Back up a read-only btrfs snapshot so every file comes from the same moment (RustFS, dumps, metrics).
# "+" runs these steps as root outside the sandbox. A leftover snapshot is deleted only when it exists:
# btrfs logs a missing one as "ERROR: Could not statfs", which the BackupFailed alert counts.
ExecStartPre=+/bin/sh -c 'if [ -e {{ packages_kopia_snapshot_path }} ]; then exec /usr/bin/btrfs subvolume delete {{ packages_kopia_snapshot_path }}; fi'
ExecStartPre=+/usr/bin/btrfs subvolume snapshot -r {{ packages_kopia_snapshot_root }} {{ packages_kopia_snapshot_path }}

ExecStart=/usr/bin/kopia snapshot create {{ packages_kopia_snapshot_path }}{{ packages_kopia_backup_path[packages_kopia_snapshot_root | length:] }} \
    --override-source={{ packages_kopia_backup_path }}

ExecStopPost=-+/bin/sh -c 'if [ -e {{ packages_kopia_snapshot_path }} ]; then exec /usr/bin/btrfs subvolume delete {{ packages_kopia_snapshot_path }}; fi'
{% else %}
ExecStart=/usr/bin/kopia snapshot create {{ packages_kopia_backup_path }}
{% endif %}

[Install]
WantedBy=multi-user.target
