{% if target_host in services['packages']['kopia']['units']['server']['hosts'] %}
KOPIA_PASSWORD="{{ secrets['kopia']['repository'][target_host] | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% elif target_host in services['packages']['kopia']['units']['client']['hosts'] %}
KOPIA_PASSWORD="{{ secrets['kopia']['users'][target_host] | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endif %}
KOPIA_CONFIG_PATH=/etc/kopia/repository.config
KOPIA_CACHE_DIRECTORY=/var/cache/kopia
KOPIA_LOG_DIR=/var/cache/kopia/logs
KOPIA_CHECK_FOR_UPDATES=false
KOPIA_USE_KEYRING=false
