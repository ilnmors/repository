[Unit]
Description=DDNS Update Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot

StandardOutput=journal
StandardError=journal

EnvironmentFile=/etc/secrets/%u/ddns/cloudflare.env

# Run the script
ExecStart=/usr/local/bin/ddns.sh -d "{{ site['domain']['public'] }}"
