[Unit]
Description=Daily Kopia rclone backup service
Wants=network-online.target
After=network-online.target

RequiresMountsFor={{ nodes[target_host]['paths']['data'] }}

[Service]
Type=oneshot
User={{ nodes[target_host]['user'] }}
Group={{ nodes[target_host]['group'] }}

# logging
StandardOutput=journal
StandardError=journal

CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH

ProtectSystem=strict
ProtectHome=tmpfs
InaccessiblePaths=/boot /root

BindReadOnlyPaths={{ nodes[target_host]['paths']['data'] }}

# In root namescope, %u always bring 0
BindPaths=/etc/secrets/{{ nodes[target_host]['user'] }}
Environment="RCLONE_CONFIG=/etc/secrets/{{ nodes[target_host]['user'] }}/rclone.config"

ExecStart=/usr/bin/rclone copy {{ nodes[target_host]['paths']['data'] }} gdrive:{{ site['org'] }} \
    --transfers=4 \
    --checkers=4 \
    --tpslimit=8 \
    --tpslimit-burst=4 \
    --drive-chunk-size=64M \
    --retries=20 \
    --low-level-retries=10 \
    --retries-sleep=30s \
    --timeout=3m \
    --contimeout=30s \
    --drive-stop-on-upload-limit \
    --stats=30s \
    --log-level=INFO
