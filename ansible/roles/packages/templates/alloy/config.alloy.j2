// Label schema (metrics and logs)
//   instance  host name from the inventory
//   job       service name from the inventory (node for host metrics, kernel for kernel logs)
//   level     logs only: debug | info | warn | error | fatal
//   stream    logs only, for services with a second log file: access (caddy), eve (suricata)
// Values with many distinct values (HTTP status, method, URI, client IP, SSH user, Suricata
// severity) are structured metadata, not labels.

// ---------------------------------------------------------------------------------------------
// Metrics
// ---------------------------------------------------------------------------------------------

prometheus.remote_write "prometheus" {
    endpoint {
        url = "https://{{ services['containers']['prometheus']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}:{{ services['containers']['prometheus']['units']['main']['ports']['https']['int'] }}/api/v1/write"
        tls_config {
            ca_file = "/etc/alloy/{{ site['ca']['x509']['root']['certificate_file'] }}"
        }
    }
}

// Every series gets instance=<host>; job is set per input below.
prometheus.relabel "metrics" {
    forward_to = [prometheus.remote_write.prometheus.receiver]

    rule {
        target_label = "instance"
        replacement  = "{{ target_host }}"
    }
}

// Host metrics: systemd unit names lose the .service suffix (timers and sockets keep theirs).
prometheus.relabel "node" {
    forward_to = [prometheus.relabel.metrics.receiver]

    rule {
        target_label = "job"
        replacement  = "node"
    }
    rule {
        source_labels = ["name"]
        regex         = "(.+)\\.service"
        target_label  = "name"
        replacement   = "$1"
    }
{% if target_host in services['packages']['smart-exporter']['units']['main']['hosts'] %}
    // smart-exporter writes smartctl_* through the textfile collector.
    rule {
        source_labels = ["__name__"]
        regex         = "smartctl_.+"
        target_label  = "job"
        replacement   = "smart-exporter"
    }
{% endif %}
}

prometheus.exporter.unix "node" {
    enable_collectors = [
        "systemd",
        "cgroup",
        "processes",
        "textfile",
        "btrfs",
    ]
    filesystem {
        mount_points_exclude = "^/(boot|sys|proc|dev|run|mnt|var/lib/docker/.+|var/lib/kubelet/.+)($|/)"
        fs_types_exclude     = "^(tmpfs|devtmpfs|devfs|iso9660|overlay|aufs|squashfs)$"
    }
{% if target_host in services['packages']['smart-exporter']['units']['main']['hosts'] %}
    textfile {
        directory = "/etc/smartctl-exporter"
    }
{% endif %}
}

prometheus.scrape "node" {
    targets    = prometheus.exporter.unix.node.targets
    forward_to = [prometheus.relabel.node.receiver]
}
{% if target_host in services['packages']['crowdsec']['units']['lapi']['hosts'] %}

prometheus.scrape "crowdsec" {
    targets = [{
        "__address__" = "{{ services['packages']['crowdsec']['units']['lapi']['domain']['internal'] }}.{{ site['domain']['internal'] }}:{{ services['packages']['crowdsec']['units']['lapi']['ports']['metrics']['ext'] }}",
        "job"         = "crowdsec",
    }]
    forward_to = [prometheus.relabel.metrics.receiver]
}
{% endif %}
{% if target_host in services['containers']['x509-exporter']['units']['main']['hosts'] %}

prometheus.scrape "x509_exporter" {
    targets = [{
        "__address__" = "127.0.0.1:{{ services['containers']['x509-exporter']['units']['main']['ports']['http']['int'] }}",
        "job"         = "x509-exporter",
    }]
    forward_to = [prometheus.relabel.metrics.receiver]
}
{% endif %}
{% if target_host in services['containers']['postgresql']['units']['main']['hosts'] %}

prometheus.exporter.postgres "postgresql" {
    data_source_names = [
        "postgres://alloy@{{ services['containers']['postgresql']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}:{{ services['containers']['postgresql']['units']['main']['ports']['tcp']['int'] }}/postgres?sslmode=verify-full",
    ]
}

discovery.relabel "postgresql" {
    targets = prometheus.exporter.postgres.postgresql.targets
    rule {
        target_label = "job"
        replacement  = "postgresql"
    }
}

prometheus.scrape "postgresql" {
    targets    = discovery.relabel.postgresql.output
    forward_to = [prometheus.relabel.metrics.receiver]
}
{% endif %}
{% if target_host in services['containers']['caddy']['units']['main']['hosts'] %}

prometheus.scrape "caddy" {
    targets = [{
        "__address__" = "caddy.{{ target_host }}.{{ site['domain']['internal'] }}:443",
        "job"         = "caddy",
    }]
    scheme     = "https"
    forward_to = [prometheus.relabel.metrics.receiver]
}
{% endif %}

// ---------------------------------------------------------------------------------------------
// Logs
// ---------------------------------------------------------------------------------------------

loki.write "loki" {
    endpoint {
        url       = "https://{{ services['containers']['loki']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}:{{ services['containers']['loki']['units']['main']['ports']['https']['int'] }}/loki/api/v1/push"
        tenant_id = "{{ site['domain']['internal'] }}"
        tls_config {
            ca_file = "/etc/alloy/{{ site['ca']['x509']['root']['certificate_file'] }}"
        }
    }
}

// journald: job is the systemd (user) unit without .service; container is a temporary label
// for the level parser and is dropped before the logs are written.
loki.relabel "journal" {
    forward_to = []

    rule {
        target_label = "instance"
        replacement  = "{{ target_host }}"
    }
    rule {
        target_label = "job"
        replacement  = "journal"
    }
    // Fallback: the syslog identifier (sudo, sshd in a session scope, ...).
    rule {
        source_labels = ["__journal_syslog_identifier"]
        regex         = "(.+)"
        target_label  = "job"
        replacement   = "$1"
    }
    // Services, timers and sockets name the job; scopes (login sessions) keep the syslog identifier.
    rule {
        source_labels = ["__journal__systemd_unit"]
        regex         = "(.+)\\.service|(.+\\.(?:timer|socket))"
        target_label  = "job"
        replacement   = "$1$2"
    }
    rule {
        source_labels = ["__journal__systemd_user_unit"]
        regex         = "(.+)\\.service|(.+\\.(?:timer|socket))"
        target_label  = "job"
        replacement   = "$1$2"
    }
    // Messages of the service managers themselves: PID 1 and the per-user manager.
    rule {
        source_labels = ["__journal__systemd_unit"]
        regex         = "init\\.scope"
        target_label  = "job"
        replacement   = "systemd"
    }
    rule {
        source_labels = ["job"]
        regex         = "user@\\d+"
        target_label  = "job"
        replacement   = "systemd-user"
    }
    rule {
        source_labels = ["__journal_syslog_identifier"]
        regex         = "podman"
        target_label  = "job"
        replacement   = "podman"
    }
    rule {
        source_labels = ["__journal__transport"]
        regex         = "kernel"
        target_label  = "job"
        replacement   = "kernel"
    }
    // Processes PID 1 forks before exec, such as generators: "(sd-exec-strv)" cut to 15 characters.
    rule {
        source_labels = ["__journal_syslog_identifier"]
        regex         = "\\(sd-.+"
        target_label  = "job"
        replacement   = "systemd"
    }
    // Ansible modules log as ansible-<module>; keep them under one job.
    rule {
        source_labels = ["__journal_syslog_identifier"]
        regex         = "ansible-.+"
        target_label  = "job"
        replacement   = "ansible"
    }
    rule {
        source_labels = ["__journal_container_name"]
        regex         = "(.+)"
        target_label  = "container"
        replacement   = "$1"
    }
    // journald priority keywords: emerg alert crit error warning notice info debug
    rule {
        target_label = "level"
        replacement  = "info"
    }
    rule {
        source_labels = ["__journal_priority_keyword"]
        regex         = "debug"
        target_label  = "level"
        replacement   = "debug"
    }
    rule {
        source_labels = ["__journal_priority_keyword"]
        regex         = "warning"
        target_label  = "level"
        replacement   = "warn"
    }
    rule {
        source_labels = ["__journal_priority_keyword"]
        regex         = "error"
        target_label  = "level"
        replacement   = "error"
    }
    rule {
        source_labels = ["__journal_priority_keyword"]
        regex         = "emerg|alert|crit"
        target_label  = "level"
        replacement   = "fatal"
    }
}

loki.source.journal "journal" {
    forward_to    = [loki.process.journal.receiver]
    relabel_rules = loki.relabel.journal.rules
}

loki.process "journal" {
    forward_to = [loki.write.loki.receiver]

    // Containers write everything to stdout/stderr, and journald files stderr as error.
    // Start from info and take the level from the message instead.
    stage.match {
        selector = "{container=~\".+\"}"
        stage.static_labels {
            values = { level = "info" }
        }
    }

    // Level written in the message: key=value or JSON (level, lvl, severity; pino numbers),
    // or a level word among the first tokens ([WARN], ERROR:, FATAL ...). Only info lines are
    // re-read, so real journald priorities from host services stay as they are.
    stage.match {
        selector = "{level=\"info\"} |~ \"(?i)(^|[\\\\s{,\\\"'])(level|lvl|severity|loglevel)[\\\"']?\\\\s*[=:]\\\\s*[\\\"']?(trace|debug|dbg|10|20)\\\\b\""
        stage.static_labels {
            values = { level = "debug" }
        }
    }
    stage.match {
        selector = "{level=\"info\"} |~ \"(?i)(^|[\\\\s{,\\\"'])(level|lvl|severity|loglevel)[\\\"']?\\\\s*[=:]\\\\s*[\\\"']?(warn|warning|40)\\\\b\""
        stage.static_labels {
            values = { level = "warn" }
        }
    }
    stage.match {
        selector = "{level=\"info\"} |~ \"(?i)(^|[\\\\s{,\\\"'])(level|lvl|severity|loglevel)[\\\"']?\\\\s*[=:]\\\\s*[\\\"']?(err|error|50)\\\\b\""
        stage.static_labels {
            values = { level = "error" }
        }
    }
    stage.match {
        selector = "{level=\"info\"} |~ \"(?i)(^|[\\\\s{,\\\"'])(level|lvl|severity|loglevel)[\\\"']?\\\\s*[=:]\\\\s*[\\\"']?(fatal|crit|critical|panic|emerg|alert|60)\\\\b\""
        stage.static_labels {
            values = { level = "fatal" }
        }
    }
    stage.match {
        selector = "{level=\"info\"} |~ \"^(\\\\S+\\\\s+){0,4}(\\\\x1b\\\\[[0-9;]*m)?\\\\[?(WARN|WARNING)\\\\]?(\\\\x1b\\\\[[0-9;]*m)?([\\\\s:\\\\]]|$)\""
        stage.static_labels {
            values = { level = "warn" }
        }
    }
    stage.match {
        selector = "{level=\"info\"} |~ \"^(\\\\S+\\\\s+){0,4}(\\\\x1b\\\\[[0-9;]*m)?\\\\[?(ERR|ERROR)\\\\]?(\\\\x1b\\\\[[0-9;]*m)?([\\\\s:\\\\]]|$)\""
        stage.static_labels {
            values = { level = "error" }
        }
    }
    stage.match {
        selector = "{level=\"info\"} |~ \"^(\\\\S+\\\\s+){0,4}(\\\\x1b\\\\[[0-9;]*m)?\\\\[?(CRIT|CRITICAL|FATAL|PANIC)\\\\]?(\\\\x1b\\\\[[0-9;]*m)?([\\\\s:\\\\]]|$)\""
        stage.static_labels {
            values = { level = "fatal" }
        }
    }

    // Normal shutdowns some programs log as fatal: Go's http.ErrServerClosed
    // (crowdsec 1.4: level=fatal msg="while serving local API: http: Server closed").
    stage.match {
        selector = "{level=~\"error|fatal\"} |= \"http: Server closed\""
        stage.static_labels {
            values = { level = "info" }
        }
    }

    // Crashes are fatal whatever the stream says.
    stage.match {
        selector = "{level!=\"fatal\"} |~ \"(?i)(\\\\bpanic: |segfault at |out of memory: killed process|invoked oom-killer|kernel BUG at|assertion .* failed)\""
        stage.static_labels {
            values = { level = "fatal" }
        }
    }

    // podman health checks: job is the container, health_status=healthy|unhealthy.
    stage.match {
        selector = "{job=\"podman\"} |~ \"container health_status .*health_status=\""
        stage.regex {
            expression = "container health_status (?P<container_id>[^ ]+) .*name=(?P<container_name>[^,\\)]+)"
        }
        stage.regex {
            expression = "health_status=(?P<health_status>[^,\\)]+)"
        }
        stage.labels {
            values = {
                job           = "container_name",
                health_status = "",
            }
        }
        stage.structured_metadata {
            values = { container_id = "" }
        }
        stage.static_labels {
            values = { level = "info" }
        }
    }
    stage.match {
        selector = "{health_status=\"unhealthy\"}"
        stage.static_labels {
            values = { level = "error" }
        }
    }

    // sshd: accepted logins keep the user as structured metadata.
    stage.match {
        selector = "{job=~\"ssh|sshd\"} |= \"Accepted \""
        stage.regex {
            expression = "Accepted \\w+ for (?P<user>[^ ]+) from (?P<remote_ip>[0-9a-fA-F:.]+)"
        }
        stage.structured_metadata {
            values = {
                user      = "",
                remote_ip = "",
            }
        }
    }

    stage.label_drop {
        values = ["container"]
    }
}
{% if target_host in services['packages']['suricata']['units']['main']['hosts'] %}

// Suricata eve.json: event_type is a label; alerts are warn, severity 1-2 errors.
local.file_match "suricata" {
    path_targets = [{
        "__path__" = "/var/log/suricata/eve.json",
        "instance" = "{{ target_host }}",
        "job"      = "suricata",
        "stream"   = "eve",
        "level"    = "info",
    }]
}

loki.source.file "suricata" {
    targets    = local.file_match.suricata.targets
    forward_to = [loki.process.suricata.receiver]
}

loki.process "suricata" {
    forward_to = [loki.write.loki.receiver]

    stage.json {
        expressions = {
            event_type = "event_type",
            severity   = "alert.severity",
            src_ip     = "src_ip",
        }
    }
    stage.labels {
        values = { event_type = "" }
    }
    stage.structured_metadata {
        values = {
            severity = "",
            src_ip   = "",
        }
    }
    stage.match {
        selector = "{event_type=\"alert\"}"
        stage.static_labels {
            values = { level = "warn" }
        }
    }
    stage.match {
        selector = "{event_type=\"alert\"} |~ \"\\\"severity\\\":[12][,}]\""
        stage.static_labels {
            values = { level = "error" }
        }
    }
    stage.label_drop {
        values = ["filename"]
    }
}
{% endif %}
{% if target_host in services['containers']['caddy']['units']['main']['build']['http-bouncer']['hosts'] and target_host in services['containers']['caddy']['units']['main']['build']['crowdsec-bouncer']['hosts'] %}

// Caddy access log: host is a label; 401/403/429 are warn, 5xx errors.
local.file_match "caddy_access" {
    path_targets = [{
        "__path__" = "/var/log/caddy/access.log",
        "instance" = "{{ target_host }}",
        "job"      = "caddy",
        "stream"   = "access",
        "level"    = "info",
    }]
}

loki.source.file "caddy_access" {
    targets    = local.file_match.caddy_access.targets
    forward_to = [loki.process.caddy_access.receiver]
}

loki.process "caddy_access" {
    forward_to = [loki.write.loki.receiver]

    stage.json {
        expressions = {
            status    = "status",
            duration  = "duration",
            method    = "request.method",
            host      = "request.host",
            uri       = "request.uri",
            remote_ip = "request.remote_ip",
        }
    }
    stage.labels {
        values = { host = "" }
    }
    stage.structured_metadata {
        values = {
            status    = "",
            method    = "",
            uri       = "",
            remote_ip = "",
            duration  = "",
        }
    }
    stage.match {
        selector = "{job=\"caddy\"} |~ \"\\\"status\\\":(401|403|429)[,}]\""
        stage.static_labels {
            values = { level = "warn" }
        }
    }
    stage.match {
        selector = "{job=\"caddy\"} |~ \"\\\"status\\\":5[0-9][0-9][,}]\""
        stage.static_labels {
            values = { level = "error" }
        }
    }
    stage.label_drop {
        values = ["filename"]
    }
}
{% endif %}
