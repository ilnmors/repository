{% set host = networks['segments']['server']['hosts']['auth'] %}
$ORIGIN {{ networks['dns']['zones']['public']['domain'] }}.
$TTL 3600
@ IN SOA {{ networks['segments']['server']['hosts']['bind']['domain'] }}.{{ networks['dns']['zones']['internal']['domain'] }}. bind.{{ networks['dns']['zones']['internal']['domain'] }}. (
    {{ networks['dns']['serial'] }} ; serial
    3600 ; refresh
    1800 ; retry
    604800 ; expire
    300 ; negative TTL
)
@ IN NS {{ networks['segments']['server']['hosts']['bind']['domain'] }}.{{ networks['dns']['zones']['internal']['domain'] }}.
@ IN A {{ host['ipv4'] }}
{% if host['ipv6'] | default(none) %}
@ IN AAAA {{ host['ipv6'] }}
{% endif %}
* IN A {{ host['ipv4'] }}
{% if host['ipv6'] | default(none) %}
* IN AAAA {{ host['ipv6'] }}
{% endif %}
{{ networks['dns']['zones']['public_forward']['domain'] }} IN NS gracie.ns.cloudflare.com.
{{ networks['dns']['zones']['public_forward']['domain'] }} IN NS osmar.ns.cloudflare.com.
