# Checked hourly by suricata-logrotate.timer, so maxsize holds during alert storms. Rotated files are compressed at once
# (about 21x for eve.json, 45x for fast.log): Suricata reopens its logs in postrotate and CrowdSec reads only eve.json.
/var/log/suricata/*.log /var/log/suricata/*.json {
    weekly
    missingok
    rotate 4
    compress
    notifempty
    maxsize 500M
    create 0644 root root
    sharedscripts
    postrotate
        /usr/bin/suricatasc -c reopen-log-files > /dev/null 2>&1 || true
    endscript
}
