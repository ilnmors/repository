{# Open WebUI lists the chat models in services.containers.openwebui.units.main.ai: [fast, careful]. #}
{% set gemma = services['containers']['openwebui']['units']['main']['ai']['chat_models'][0] %}
{% set qwen = services['containers']['openwebui']['units']['main']['ai']['chat_models'][1] %}
{
  "$schema": "https://opencode.ai/config.json",
  // Local models only, through Open WebUI (its API keys reach only the chat, model and embedding endpoints).
  "provider": {
    "openwebui": {
      "name": "Open WebUI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://{{ services['containers']['openwebui']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}/api",
        "apiKey": "{file:{{ nodes[target_host]['paths']['home'] }}/.config/opencode/openwebui-api-key}",
        "timeout": 1800000,
        "chunkTimeout": 600000
      },
      "models": {
        "{{ qwen }}": {
          "name": "Qwen3.8 27B",
          "tool_call": true, "reasoning": true, "attachment": true, "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 65536, "output": 16384 }
        },
        "{{ gemma }}": {
          "name": "Gemma 4 26B-A4B",
          "tool_call": true, "reasoning": true, "attachment": true, "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 65536, "output": 16384 }
        }
      }
    }
  },
  "enabled_providers": ["openwebui"],
  "model": "openwebui/{{ qwen }}",
  "small_model": "openwebui/{{ gemma }}",
  "share": "disabled",
  "autoupdate": false,
  // Headless agents for Claude Code ("opencode run --agent ..."): a run cannot answer "ask",
  // so they turn the secret rules into deny or allow. Subagents would fall back to "ask", so they are off.
  "agent": {
    "delegate": {
      "mode": "primary",
      "description": "Claude Code delegation; secret-looking files are denied.",
      "steps": 80,
      "permission": {
        "read": { "*secret*": "deny", "*vault*pass*": "deny", "*.env": "deny", "*.env.*": "deny",
                  "*.key": "deny", "*.pem": "deny", "*/.ssh/*": "deny" },
        "edit": { "*secret*": "deny", "*.env": "deny" },
        "task": "deny"
      }
    },
    "delegate-secrets": {
      "mode": "primary",
      "description": "Claude Code delegation the user explicitly approved to touch secret-looking files.",
      "steps": 80,
      "permission": {
        "read": { "*secret*": "allow", "*vault*pass*": "allow", "*.env": "allow", "*.env.*": "allow",
                  "*.key": "allow", "*.pem": "allow", "*/.ssh/*": "allow" },
        "edit": { "*secret*": "allow", "*.env": "allow" },
        "task": "deny"
      }
    }
  },
  // Within each object the last matching pattern wins. Headless runs cannot answer "ask",
  // so everything a run can reach is allow or deny.
  "permission": {
    // Secret-looking files need an explicit approval each time (the models are local, but still).
    "read": { "*": "allow", "*secret*": "ask", "*vault*pass*": "ask", "*.env": "ask", "*.env.*": "ask",
              "*.key": "ask", "*.pem": "ask", "*/.ssh/*": "ask" },
    "edit": { "*": "allow", "*secret*": "ask", "*.env": "ask", "*/.git/*": "deny" },
    // grep is checked against the search pattern, not the path, so it would bypass the rules above.
    "glob": "allow",
    "grep": "deny",
    "list": "allow",
    "lsp": "deny",
    "todowrite": "allow",
    "task": "allow",
    "skill": "allow",
    "bash": {
      "*": "deny",
      "git status *": "allow", "git diff *": "allow", "git log *": "allow", "git show *": "allow",
      "ansible-lint *": "allow", "yamllint *": "allow", "shellcheck *": "allow", "python3 -m py_compile *": "allow"
    },
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny",
    "doom_loop": "deny"
  }
}
