{# Open WebUI lists the chat models in services.containers.openwebui.units.main.ai: the first is the fast one, the last
   the careful one (the same model when only one is listed). Strata serves Qwen3.8-Flash-Next with a 64k context. #}
{% set chat_models = services['containers']['openwebui']['units']['main']['ai']['chat_models'] %}
{
  "$schema": "https://opencode.ai/config.json",
  // DeepSeek is the default. Local Qwen takes work where 47 t/s is enough, GLM-5.3-Flash the hard jobs.
  "model": "opencode-go/deepseek-v4.1-flash",
  // Local models come through Open WebUI, the Go subscription serves DeepSeek. Other providers and models are hidden.
  "providers": {
    "openwebui": {
      "name": "Open WebUI",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://{{ services['containers']['openwebui']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}/api",
        "apiKey": "{file:{{ nodes[target_host]['paths']['home'] }}/.config/opencode/openwebui-api-key}",
        "timeout": 1800000,
        "chunkTimeout": 600000
      },
      "models": {
{% for model in chat_models %}
        "{{ model }}": {
          "name": "{{ model }}",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
            "reasoning": { "supported": true }
          },
          "compatibility": { "reasoningField": "reasoning_content" },
          "limit": { "context": 65536, "output": 16384 }
        }{{ "," if not loop.last }}
{% endfor %}
      }
    },
    // The Go catalog lists more models. Add a new one here as disabled unless it should be selectable.
    "opencode-go": {
      "models": {
        "beam-free": { "disabled": true },
        "claude-haiku-5-5": { "disabled": true },
        "deepseek-v4-pro": { "disabled": true },
        "gemini-4-argon": { "disabled": true },
        "glm-5.3": { "disabled": true },
        "gpt-5.6-luna": { "disabled": true },
        "gpt-6-luna": { "disabled": true },
        "grok-4.7": { "disabled": true },
        "hungerg-free": { "disabled": true },
        "hy3": { "disabled": true },
        "hy4": { "disabled": true },
        "hy4-flash-free": { "disabled": true },
        "hy4-preview": { "disabled": true },
        "iceman-contributor-free": { "disabled": true },
        "kimi-k2.7-code": { "disabled": true },
        "kimi-k3": { "disabled": true },
        "kimi-k3.1-pro": { "disabled": true },
        "longcat-2.5": { "disabled": true },
        "mimo-v2.6-flash": { "disabled": true },
        "mimo-v2.6-pro": { "disabled": true },
        "minimax-m3": { "disabled": true },
        "minimax-m3.1-flash": { "disabled": true },
        "muse-spark-1.2-contributor": { "disabled": true },
        "muse-spark-1.3-contributor": { "disabled": true },
