{# Open WebUI lists the chat models in services.containers.openwebui.units.main.ai: the first is the fast one, the last
   the careful one (the same model when only one is listed). Strata serves Qwen3.8-Flash-Next with a 64k context. #}
{% set chat_models = services['containers']['openwebui']['units']['main']['ai']['chat_models'] %}
{
  "$schema": "https://opencode.ai/config.json",
  // Local models only, through Open WebUI (its API keys reach only the chat, model and embedding endpoints).
  "provider": {
    "openwebui": {
      "name": "Open WebUI",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://{{ services['containers']['openwebui']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}/api",
        "apiKey": "{file:{{ nodes[target_host]['paths']['home'] }}/.config/opencode/openwebui-api-key}",
        "timeout": 1800000,
        "chunkTimeout": 600000
      },
      "models": {
{% for model in chat_models %}
        "{{ model }}": {
          "name": "{{ model }}",
          "tool_call": true, "reasoning": true, "attachment": true, "interleaved": { "field": "reasoning_content" },
          "limit": { "context": 65536, "output": 16384 }
        }{{ "," if not loop.last }}
{% endfor %}
      }
    }
  },
  "enabled_providers": ["openwebui"],
  "model": "openwebui/{{ chat_models | last }}",
  "small_model": "openwebui/{{ chat_models | first }}",
  "share": "disabled",
  "autoupdate": false,
  // Headless agents for Claude Code ("opencode run --agent ..."): a run cannot answer "ask",
  // so they turn the secret rules into deny or allow. Subagents would fall back to "ask", so they are off.
  "agent": {
    "delegate": {
      "mode": "primary",
      "description": "Claude Code delegation; secret-looking files are denied.",
      "steps": 80,
      "permission": {
        "read": { "*secret*": "deny", "*vault*pass*": "deny", "*.env": "deny", "*.env.*": "deny",
                  "*.key": "deny", "*.pem": "deny", "*/.ssh/*": "deny" },
        "edit": { "*secret*": "deny", "*.env": "deny" },
        "task": "deny"
      }
    },
    "delegate-secrets": {
      "mode": "primary",
      "description": "Claude Code delegation the user explicitly approved to touch secret-looking files.",
      "steps": 80,
      "permission": {
        "read": { "*secret*": "allow", "*vault*pass*": "allow", "*.env": "allow", "*.env.*": "allow",
                  "*.key": "allow", "*.pem": "allow", "*/.ssh/*": "allow" },
        "edit": { "*secret*": "allow", "*.env": "allow" },
        "task": "deny"
      }
    }
  },
  // Within each object the last matching pattern wins. Read/search/inspection tools are allowed freely
  // (models are local), while edits and modifying/destructive shell commands require confirmation.
  "permission": {
    "read": "allow",
    "edit": "ask",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "task": "allow",
    "skill": "allow",
    "external_directory": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "bash": {
      "*": "ask",
      // Git (read-only)
      "git status": "allow", "git status *": "allow",
      "git diff": "allow", "git diff *": "allow",
      "git log": "allow", "git log *": "allow",
      "git show": "allow", "git show *": "allow",
      "git branch": "allow", "git branch *": "allow",
      "git remote": "allow", "git remote *": "allow",
      "git rev-parse *": "allow",
      "git ls-files": "allow", "git ls-files *": "allow",
      "git grep *": "allow", "git blame *": "allow",
      // Linters & dry-run checks
      "ansible-lint *": "allow", "yamllint *": "allow", "shellcheck *": "allow",
      "python3 -m py_compile *": "allow",
      "ansible-playbook *--syntax-check*": "allow",
      "ansible-playbook *--list-tasks*": "allow",
      // Filesystem, search & text inspection (read-only)
      "ls": "allow", "ls *": "allow",
      "tree": "allow", "tree *": "allow",
      "stat *": "allow", "file *": "allow", "wc *": "allow",
      "du *": "allow", "df": "allow", "df *": "allow",
      "pwd": "allow", "realpath *": "allow", "readlink *": "allow",
      "which *": "allow", "id": "allow", "uname *": "allow", "uptime": "allow", "uptime *": "allow", "date": "allow", "date *": "allow",
      "cat *": "allow", "head *": "allow", "tail *": "allow",
      "grep *": "allow", "rg *": "allow", "find *": "allow", "fd *": "allow",
      "jq *": "allow", "yq *": "allow", "diff *": "allow", "cmp *": "allow",
      "sort *": "allow", "uniq *": "allow", "cut *": "allow", "tr *": "allow", "awk *": "allow", "sed -n *": "allow",
      "sha256sum *": "allow", "md5sum *": "allow",
      // System & container inspection (read-only)
      "ps": "allow", "ps *": "allow", "pgrep *": "allow",
      "ss *": "allow", "ip a": "allow", "ip addr*": "allow", "ip route*": "allow", "ip link*": "allow",
      "journalctl *": "allow",
      "systemctl status *": "allow", "systemctl list-*": "allow", "systemctl is-*": "allow", "systemctl show *": "allow", "systemctl cat *": "allow",
      "systemctl --user status *": "allow", "systemctl --user list-*": "allow", "systemctl --user is-*": "allow", "systemctl --user show *": "allow", "systemctl --user cat *": "allow",
      "podman ps": "allow", "podman ps *": "allow", "podman images": "allow", "podman images *": "allow",
      "podman logs *": "allow", "podman inspect *": "allow",
      // Safety guards (last match wins): always ask on writes, redirections, deletes, or privilege escalation
      "* > *": "ask", "* >> *": "ask", "*tee *": "ask",
      "*--delete*": "ask", "*-delete*": "ask", "*-exec*": "ask",
      "*sudo *": "ask", "*pkexec *": "ask"
    },
    "question": "ask",
    "doom_loop": "ask"
  }
}
