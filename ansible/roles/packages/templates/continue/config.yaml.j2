{# Open WebUI lists the chat models in services.containers.openwebui.units.main.ai; Strata serves Flash-Next with a 64k context. #}
{% set ai = services['containers']['openwebui']['units']['main']['ai'] %}
# Continue in code-server: chat/edit/apply through Open WebUI (its API keys reach only the
# chat, model and embedding endpoints; key from ~/.continue/.env), and tab autocomplete
# directly through Quartermaster on the Iris Xe (/v1/completions).
name: Local models
version: 1.0.0
schema: v1
models:
{% for model in ai['chat_models'] %}
  - name: {{ model }}
    provider: openai
    model: {{ model }}
    apiBase: https://{{ services['containers']['openwebui']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}/api
    apiKey: {{ '${{ secrets.OPENWEBUI_API_KEY }}' }}
    roles: [chat, edit, apply]
    capabilities: [tool_use, image_input]
    defaultCompletionOptions:
      contextLength: 65536
      maxTokens: 16384
{% endfor %}
  - name: qwen2.5-coder-1.5b
    provider: openai
    model: qwen2.5-coder-1.5b
    apiBase: https://{{ services['containers']['quartermaster']['units']['main']['domain']['internal'] }}.{{ site['domain']['internal'] }}/v1
    apiKey: "none"
    useLegacyCompletionsEndpoint: true
    roles: [autocomplete]
    requestOptions:
      caBundlePath: /usr/local/share/ca-certificates/{{ site['ca']['x509']['root']['certificate_file'] }}
    defaultCompletionOptions:
      contextLength: 4096
      maxTokens: 64
      temperature: 0.0
      stop:
        - "<|endoftext|>"
        - "<|fim_pad|>"
        - "<|file_sep|>"
    autocompleteOptions:
      maxPromptTokens: 512
      debounceDelay: 450
      useRecentlyOpened: false
      experimental_includeClipboard: false
      experimental_includeRecentlyVisitedRanges: false
      experimental_includeRecentlyEditedRanges: false
      experimental_includeDiff: false
    promptTemplates:
      autocomplete: {% raw %}"<|fim_prefix|>{{{prefix}}}<|fim_suffix|>{{{suffix}}}<|fim_middle|>"{% endraw %}
