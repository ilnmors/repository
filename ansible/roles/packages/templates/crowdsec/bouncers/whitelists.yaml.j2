name: local/console-whitelists
description: "Local whitelist policy"
whitelist:
    reason: "rules"
    ip:
        # Console IP lists
        - "127.0.0.1"
        - "::1"
{% for host in (
        networks['segments']
        | dict2items
        | selectattr('value.hosts', 'defined')
        | selectattr('value.hosts.console', 'defined')
        | map(attribute='key')
        | list
    )
%}
{% if (networks['segments'][host]['hosts']['console']['ipv4'] | default(none)) %}
        - "{{ networks['segments'][host]['hosts']['console']['ipv4'] }}"
{% endif %}
{% if (networks['segments'][host]['hosts']['console']['ipv6'] | default(none)) %}
        - "{{ networks['segments'][host]['hosts']['console']['ipv6'] }}"
{% endif %}
{% endfor %}
{% if target_host in
    services['packages']['crowdsec']['units']['http-bouncer']['hosts'] + services['packages']['crowdsec']['units']['fw-bouncer']['hosts']
%}
{% if target_host in services['packages']['crowdsec']['units']['fw-bouncer']['hosts'] %}
    # expression:
        # following whitelists
{% endif %}
{% if target_host in services['packages']['crowdsec']['units']['http-bouncer']['hosts'] %}
    expression:
        # immich thumbnail request 404 error false positive
        - "evt.Meta.target_fqdn == '{{ services['containers']['immich']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}' && evt.Meta.http_status == '404' && evt.Meta.http_verb == 'GET' && evt.Meta.http_path contains '/api/assets/' && evt.Meta.http_path contains '/thumbnail'"
        # outline POST 401 errors false positive
        - "evt.Meta.target_fqdn == '{{ services['containers']['outline']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}' && evt.Meta.http_status == '401' && evt.Meta.http_verb == 'POST' && evt.Meta.http_path startsWith '/api/'"
        # openwebui images request 404 error false positive
        - "evt.Meta.target_fqdn == '{{ services['containers']['openwebui']['units']['main']['domain']['public'] }}.{{ site['domain']['public'] }}' && evt.Meta.http_status == '404' && evt.Meta.http_verb == 'GET' && evt.Meta.http_path startsWith '/api/v1/files'"
{% endif %}
{% endif %}
